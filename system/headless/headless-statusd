#!/bin/bash
# headless-statusd — status codes on the keyboard backlight for a Mac without
# a screen. Runs as root (the LED is root-only before and outside a session).
#
#   boot (no login screen yet)  slow breathing, Caps Lock light flickers fast
#   login screen ready          one long flash every ~3 s
#   session started             3 quick flashes, then silence
#   session ended / crashed     5 very quick flashes, then login screen code
#   no network (>6 s)           2 short flashes every ~2 s
#   shutdown / stop             one long fade-out
#
# Login screen sounds (played as the sddm user through its own PipeWire, since
# no desktop session exists yet): login-screen, login-failed, login-ok. The
# files come from the sound set in ~/.config/headless/soundset, freedesktop
# sounds otherwise (headless-sounds assign <event> <sound>).
#
# In a session with the network up the daemon writes nothing, so
# henri.kbdlight keeps the keys.
set -u

LED=/sys/class/leds/kbd_backlight
MAX=$(<"$LED/max_brightness")

set_led() { echo "$1" >"$LED/brightness"; }

HEADLESS_USER=${HEADLESS_USER:-henri}
UHOME=$(getent passwd "$HEADLESS_USER" | cut -d: -f6)
SDDM_UID=$(id -u sddm 2>/dev/null)
VOL=${HEADLESS_VOL:-0.5}
# The greeter's PipeWire starts at 100 %: pin it to a discreet master level.
LOGIN_MASTER=${HEADLESS_LOGIN_MASTER:-0.2}
FD=/usr/share/sounds/freedesktop/stereo

login_sound() { # event freedesktop-fallback
  [[ -n $SDDM_UID ]] || return 0
  local set f rt=/run/user/$SDDM_UID
  set=$(cat "$UHOME/.config/headless/soundset" 2>/dev/null)
  f=$(ls "$UHOME/.local/share/headless/sounds/$set/$1".{wav,ogg} 2>/dev/null | head -1)
  [[ -n $set && -n $f ]] || f="$FD/$2.oga"
  run() { runuser -u sddm -- env XDG_RUNTIME_DIR="$rt" "$@"; }
  (
    local i
    for i in {1..40}; do run wpctl status >/dev/null 2>&1 && break; sleep 0.25; done
    # No quiet master, no sound: never play at 100 %.
    run wpctl set-volume @DEFAULT_AUDIO_SINK@ "$LOGIN_MASTER" || exit 0
    run wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
    run pw-play --volume="$VOL" "$f"
  ) >/dev/null 2>&1 &
}

# The Caps Lock light (the input device's number changes, so glob).
caps() { local f; for f in /sys/class/leds/*::capslock/brightness; do [[ -w $f ]] && echo "$1" >"$f"; done; }

flash() { # on off count
  local i
  for ((i = 0; i < $3; i++)); do
    set_led "$MAX"; sleep "$1"; set_led 0; sleep "$2"
  done
}

breathe() {
  local v
  local c=0
  for v in 0 20 50 90 140 200 140 90 50 20 0; do
    set_led "$v"; caps $((c ^= 1)); sleep 0.12
  done
  caps 0
}

state() {
  local cls
  cls=$(loginctl list-sessions --no-legend 2>/dev/null | awk '$4 == "seat0" { print $6 }')
  if grep -qx user <<<"$cls"; then echo session
  elif grep -qx greeter <<<"$cls"; then echo greeter
  else echo boot; fi
}

# Run a pattern, then put the LED back where it was (session) or off.
pat() {
  local keep=0
  [[ $state == session ]] && keep=$(<"$LED/brightness")
  "$@"
  set_led "$keep"
}

# SDDM reports the outcome of every login attempt in the journal.
watch_login() {
  local line last_fail=-100
  journalctl -f -n0 -o cat --no-pager _COMM=sddm _COMM=sddm-helper 2>/dev/null |
    while IFS= read -r line; do
      case $line in
        *"Authentication error"*|*"authentication failure"*)
          ((SECONDS - last_fail >= 2)) || continue   # one event per attempt
          last_fail=$SECONDS
          login_sound login-failed dialog-error
          pat flash 0.6 0.25 2 ;;
        *"Authentication for user"*successful*)
          login_sound login-ok complete ;;
      esac
    done
}

trap 'kill $(jobs -p) 2>/dev/null; breathe; set_led 0; exit 0' TERM INT
state=boot
watch_login &

prev=boot netfail=0 last_net=-100
while :; do
  state=$(state)
  net=$(nmcli -t -g STATE general 2>/dev/null)
  if [[ $net == connected* ]]; then netfail=0; else ((netfail++)); fi

  if [[ $state != "$prev" ]]; then
    case "$prev>$state" in
      *">session") pat flash 0.08 0.08 3 ;;
      "session>"*) pat flash 0.05 0.05 5 ;;
    esac
    [[ $state == greeter ]] && login_sound login-screen message-new-instant
    prev=$state
  fi

  now=$SECONDS

  if ((netfail >= 3)) && ((now - last_net >= 2)); then
    last_net=$now; pat flash 0.08 0.1 2
  else
    case $state in
      boot)    pat breathe ;;
      greeter) pat flash 0.3 0 1; sleep 2 ;;
    esac
  fi
  sleep 1
done
