[Unit]
Description=Keyboard backlight status codes (headless use)
# As early as possible: the first sign of life should come with the kernel,
# not with the login screen.
DefaultDependencies=no
Before=sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Environment=HEADLESS_USER=henri
ExecStart=/usr/local/bin/headless-statusd
Restart=always
TimeoutStopSec=5

[Install]
WantedBy=sysinit.target
