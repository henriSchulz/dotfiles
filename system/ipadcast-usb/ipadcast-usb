#!/usr/bin/env python3
"""ipadcast-usb — a cable between this Mac and an iPad/iPhone is a network, and the screen mirror starts.

udev starts this (ipadcast-usb.service) when an Apple mobile device shows up on USB. Then:

  1. usbmuxd answers the pairing ("Trust this computer", done once; the records are in /var/lib/lockdown)
  2. pymobiledevice3 builds the lockdown tunnel: a tunN interface with an IPv6 address for this Mac
  3. MTU 4000 (the tunnel announces 16000, but packets over ~6 kB are lost) and a firewall rule for that interface
  4. ipadcast.service starts (as the desktop user), a sound + notification name the address for Safari, and the
     page is opened in Safari ON THE DEVICE through the Web Inspector interface of pymobiledevice3 (the tunnel
     address changes with every plug-in, so nobody has to type or bookmark it). Needs, once, on the iPad:
     Settings > Apps > Safari > Advanced > Web Inspector and Remote Automation, both on.
  5. while the cable stays, the tunnel stays; when it is gone, the tunnel ends and so does the mirror if this
     started it

Without a screen, after a restart: the device on the cable is there before anybody is logged in, so the tunnel comes
first (two long flashes of the keyboard light say so), then this waits for the login (typed blind, the usual
backlight and sound codes), and when the session is up ipadcast starts and a sound says "open the page".

Measured over this link (docs/ipad-usb-link.md in m1-power): 67-162 Mbit/s, 95 % of the packets within 3 ms of
their time. Needs root (the tunnel makes a network interface).

    ipadcast-usb run       the service
    ipadcast-usb status    what is up now
"""
import json, os, pwd, subprocess, sys, threading, time

USER = os.environ.get("IPADCAST_USER", "henri")
PW = pwd.getpwnam(USER)
PMD = os.path.join(PW.pw_dir, ".cache/m1power-pmd3/bin/pymobiledevice3")
TOKEN = os.path.join(PW.pw_dir, ".config/ipadcast/token")
ANNOUNCE = os.path.join(PW.pw_dir, ".local/bin/ipadcast-announce")
STATE = "/run/ipadcast-usb.json"
LAST = "/var/lib/ipadcast-usb/last-address"
PORT = 8770


def log(*a):
    print(*a, flush=True)


def sh(*cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def as_user(*cmd):
    env = [f"XDG_RUNTIME_DIR=/run/user/{PW.pw_uid}", f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{PW.pw_uid}/bus"]
    return sh("runuser", "-u", USER, "--", "env", *env, *cmd)


def apple_device():
    """Name of an iPad/iPhone on USB, or None."""
    base = "/sys/bus/usb/devices"
    for d in os.listdir(base):
        try:
            if open(f"{base}/{d}/idVendor").read().strip() == "05ac":
                prod = open(f"{base}/{d}/product").read().strip()
                if prod.startswith(("iPad", "iPhone")):
                    return prod
        except OSError:
            continue
    return None


def tun_interfaces():
    """{interface: [global IPv6 addresses]} for every tunN."""
    try:
        data = json.loads(sh("ip", "-j", "-6", "addr").stdout or "[]")
    except ValueError:
        return {}
    return {i["ifname"]: [a["local"] for a in i.get("addr_info", []) if a.get("scope") == "global"]
            for i in data if i["ifname"].startswith("tun")}


def flash_led(n=2, on=0.5, off=0.25):
    """The keyboard light, once the tunnel is up (the backlight daemon writes the same file, a short overlap is fine)."""
    led = "/sys/class/leds/kbd_backlight"
    try:
        top = int(open(f"{led}/max_brightness").read())
        was = open(f"{led}/brightness").read().strip()
        for _ in range(n):
            open(f"{led}/brightness", "w").write(str(top)); time.sleep(on)
            open(f"{led}/brightness", "w").write("0"); time.sleep(off)
        open(f"{led}/brightness", "w").write(was)
    except OSError:
        pass


def user_session_ready():
    """The desktop user's systemd manager runs (somebody has logged in)."""
    r = as_user("systemctl", "--user", "is-system-running")
    return r.stdout.strip() in ("running", "degraded")


def open_on_device(url, dev):
    """Open the page in Safari on the iPad/iPhone. The device may be locked or the setting off: keep trying for a while."""
    deadline = time.time() + 120
    shown_hint = False
    while time.time() < deadline and apple_device():
        r = as_user(PMD, "webinspector", "launch", url)
        out = (r.stdout + r.stderr).strip()
        if r.returncode == 0 and "ERROR" not in out and "not enabled" not in out:
            log(f"opened the page in Safari on the {dev}")
            return
        if "not enabled" in out and not shown_hint:
            log(f"Safari on the {dev}: Settings > Apps > Safari > Advanced > Web Inspector and Remote Automation must be on")
            as_user(ANNOUNCE, "cast-off", "dialog-information", "Spiegel: Safari am iPad",
                    "Einmal einschalten: Einstellungen > Apps > Safari > Erweitert > Web-Inspektor und Fernautomatisierung")
            shown_hint = True
        time.sleep(5)
    log("could not open the page on the device:", out[-200:] if 'out' in dir() else "")


def token():
    try:
        return open(TOKEN).read().strip()
    except OSError:
        return ""


def open_firewall(iface):
    """ufw drops what comes in on a new interface; the rule names the interface, which exists only with the cable."""
    if "ipadcast usb" in sh("ufw", "status").stdout and iface in sh("ufw", "status").stdout:
        return
    r = sh("ufw", "allow", "in", "on", iface, "to", "any", "port", str(PORT), "proto", "tcp", "comment", "ipadcast usb")
    log("ufw:", (r.stdout or r.stderr).strip().splitlines()[-1:] or "ok")


def bring_up(dev):
    """The tunnel, the MTU, the firewall. Returns (process, interface, address) or None."""
    sh("systemctl", "start", "usbmuxd")
    before = set(tun_interfaces())
    tunnel = subprocess.Popen([PMD, "lockdown", "start-tunnel", "--script-mode"], stdout=subprocess.PIPE,
                              stderr=subprocess.STDOUT, text=True)
    deadline = time.time() + 45
    while time.time() < deadline and tunnel.poll() is None:
        now = tun_interfaces()
        for name, addrs in now.items():
            if name not in before and addrs:
                sh("ip", "link", "set", "dev", name, "mtu", "4000")
                open_firewall(name)
                return tunnel, name, addrs[0]
        time.sleep(0.5)
    out = ""
    if tunnel.poll() is None:
        tunnel.terminate()
    try:
        out = tunnel.communicate(timeout=5)[0]
    except Exception:
        pass
    log(f"no tunnel for {dev}:", (out or "").strip()[-400:] or "timeout (device locked, or not trusted yet?)")
    return None


def remember(addr):
    """Is this the address of the last time? (Decides whether a bookmark on the iPad can work.)"""
    os.makedirs(os.path.dirname(LAST), exist_ok=True)
    try:
        prev = open(LAST).read().strip()
    except OSError:
        prev = ""
    open(LAST, "w").write(addr + "\n")
    return "same address as last time" if prev == addr else ("new address" if prev else "first time")


def run():
    dev = None
    for _ in range(30):                          # udev starts us a moment after the device appears
        dev = apple_device()
        if dev:
            break
        time.sleep(1)
    if not dev:
        log("no iPad/iPhone on USB")
        return
    log("device:", dev)
    up = None
    for attempt in range(1, 181):                # up to 15 minutes: the iPad may be locked, usbmuxd still starting
        up = bring_up(dev)
        if up or not apple_device():
            break
        if attempt % 6 == 1:
            log(f"attempt {attempt} failed, trying again every 5 s while the cable stays")
        time.sleep(5)
    if not up:
        return
    tunnel, iface, addr = up
    url = f"http://[{addr}]:{PORT}/{token()}/"
    name_url = f"http://omarchy.local:{PORT}/{token()}/"
    note = remember(addr)
    json.dump({"device": dev, "interface": iface, "address": addr, "url": url, "name_url": name_url, "note": note},
              open(STATE, "w"))
    os.chmod(STATE, 0o644)
    log(f"{iface} up, Mac at {addr} ({note}), mirror at {url}")
    flash_led(2)                                 # blind: the cable link is up (login may still be ahead)

    # Nobody logged in yet (just restarted, typing the password blind): the tunnel is there, the mirror waits.
    waited = False
    while tunnel.poll() is None and apple_device() and not user_session_ready():
        if not waited:
            log("waiting for the login of", USER)
            waited = True
        time.sleep(3)
    if tunnel.poll() is not None or not apple_device():
        log("cable gone before the login")
        return
    started_mirror = sh("systemctl", "--user", "-M", f"{USER}@", "is-active", "ipadcast.service").stdout.strip() != "active"
    r = as_user("systemctl", "--user", "start", "ipadcast.service")
    if r.returncode:
        log("ipadcast.service did not start:", r.stderr.strip())
    as_user(ANNOUNCE, "cast-on", "device-added", f"{dev} am Kabel",
            f"Die Seite öffnet sich am {dev} von selbst. Sonst in Safari ({note}):\n{url}")
    threading.Thread(target=open_on_device, args=(url, dev), daemon=True).start()

    gone = 0
    while tunnel.poll() is None and gone < 3:    # the cable stays: three misses in a row = gone
        gone = gone + 1 if not apple_device() else 0
        time.sleep(2)
    log("cable gone" if gone else "tunnel ended")
    if tunnel.poll() is None:
        tunnel.terminate()
        try:
            tunnel.wait(5)
        except subprocess.TimeoutExpired:
            tunnel.kill()
    try:
        os.remove(STATE)
    except OSError:
        pass
    if started_mirror:
        as_user("systemctl", "--user", "stop", "ipadcast.service")
        as_user(ANNOUNCE, "cast-off", "device-removed", "Bildschirm-Spiegel aus", f"{dev} abgesteckt")


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "run":
        if os.geteuid() != 0:
            sys.exit("run as root (the tunnel makes a network interface)")
        run()
    elif cmd == "status":
        print("device on USB:", apple_device() or "none")
        try:
            print(json.dumps(json.load(open(STATE)), indent=2))
        except (OSError, ValueError):
            print("no tunnel up")
    else:
        sys.exit(__doc__)
