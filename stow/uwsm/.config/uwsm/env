# Read by uwsm at session start and handed to the systemd user manager, so
# every app launched from the shell, the dock or a terminal gets it.
# GTK apps outside a sandbox draw their own file and app dialogs unless told to
# ask xdg-desktop-portal, where Finder answers (FileChooser, AppChooser).
export GTK_USE_PORTAL=1

# Qt Widgets apps take Velum's Kvantum theme (~/Projects/velum docs/QT.md); the menu bar's
# VelumSettings keeps ~/.config/Kvantum/kvantum.kvconfig on the current variant and appearance.
# Only where the kvantum package is installed — without it Qt stays on Fusion.
[ -e /usr/lib/qt6/plugins/styles/libkvantum.so ] && export QT_STYLE_OVERRIDE=kvantum
