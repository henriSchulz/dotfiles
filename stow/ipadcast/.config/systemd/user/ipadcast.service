[Unit]
Description=ipadcast: mirror the screen to a phone or tablet (Safari, H.264)
# Not enabled at boot: Super+Shift+F9 (ipadcast-toggle) starts and stops it.
# The hardware encoder is only loaded while somebody watches (see the server).
# Only with a Hyprland session: before the login (the tablet's "ssh mac-start" opens a user manager
# then too) the login screen has its own ipadcast on the port (m1-power/ipadcast/greeter).
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE

[Service]
ExecStart=/usr/bin/python3 %h/Projects/m1-power/ipadcast/server.py
Restart=on-failure
RestartSec=2
# a crash must not leave the Mac's keyboard and trackpad switched off (hypr/input.lua reads the flag)
ExecStopPost=/bin/sh -c 'f="%t/ipadcast/mac-input-off"; [ -e "$f" ] && rm -f "$f" && hyprctl reload >/dev/null; true'
# nor the monitor mirroring the tablet's screen (hypr/monitors.lua reads that flag)
ExecStopPost=/bin/sh -c 'f="%t/ipadcast/mirror-monitor"; [ -e "$f" ] && rm -f "$f" && hyprctl reload >/dev/null && sleep 1 && %h/.local/bin/hypr-spare-output heal; true'
# Power Mode's Mac side back to saving (ipadcast-perf.path, root); the file exists only once installed
ExecStopPost=/bin/sh -c '[ -w /run/ipadcast-perf/state ] && echo off > /run/ipadcast-perf/state; true'
