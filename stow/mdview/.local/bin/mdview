#!/bin/bash
# mdview launcher. Fast path: hand the files to the running instance over
# D-Bus (~10 ms) instead of starting Python; otherwise start the app.
app="$HOME/.local/share/mdview/mdview.py"

uri() {
  local p out="" c i LC_ALL=C
  p=$(realpath -m -- "$1")
  for ((i = 0; i < ${#p}; i++)); do
    c=${p:i:1}
    case $c in
      [a-zA-Z0-9/._~-]) out+=$c ;;
      *) out+=$(printf '%%%02X' "'$c") ;;
    esac
  done
  printf 'file://%s' "$out"
}

if (($#)) && [[ $1 != -* ]]; then
  uris=()
  for f in "$@"; do
    [[ $f == *://* ]] && uris+=("'$f'") || uris+=("'$(uri "$f")'")
  done
  list=$(IFS=,; echo "${uris[*]}")
  gdbus call --session --dest dev.henri.MdView --object-path /dev/henri/MdView \
    --method org.freedesktop.Application.Open "[$list]" "{}" >/dev/null 2>&1 && exit 0
fi
exec python3 "$app" "$@"
