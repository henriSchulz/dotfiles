[Desktop Entry]
Type=Application
Name=Markdown Viewer
GenericName=Markdown Viewer
Comment=Read and edit Markdown notes and folders – Obsidian syntax, math, Mermaid, code
Exec=mdview %F
Icon=mdview
Terminal=false
MimeType=text/markdown;text/x-markdown;
Categories=Office;Viewer;Utility;
Keywords=markdown;md;obsidian;viewer;editor;
StartupNotify=true
StartupWMClass=dev.henri.MdView
