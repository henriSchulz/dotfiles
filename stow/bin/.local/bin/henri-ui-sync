#!/bin/bash
# Mirror the central henri-ui folder into plugins that must ship their own
# copy (public repos: other users don't have ~/.local/share/henri-ui).
#
# Run automatically by henri-ui-sync.path whenever the central folder changes,
# so on this machine every plugin — vendored or not — follows at once (the
# shell hot-reloads a plugin when its files change). The vendored copies then
# show up as a diff in their repos, to be committed and pushed like any other
# change.
#
# A plugin opts in by having a henri-ui/ folder with a .henri-ui-vendored marker.
#
# Then it restarts the Omarchy shell: the shell only re-reads a plugin's own
# files on its hot-reload, and keeps already-loaded henri-ui components cached
# until a full restart. Debounced — waits until the folder has been quiet for
# $quiet seconds, so an editing burst restarts once. HENRI_UI_NO_RESTART=1 skips it.
#
# Prefs.js is machine state (the global switches, written by System Settings,
# which restarts the shell itself): vendored copies ship Prefs.default.js as
# their committed Prefs.js; only the copies of installed plugins (under
# ~/.config/omarchy/plugins) get this machine's Prefs.js, hidden from git with
# skip-worktree. A change to it alone restarts nothing here.
set -euo pipefail
quiet=2
stamp="${XDG_CACHE_HOME:-$HOME/.cache}/henri-ui-sync.stamp"

src="$HOME/.local/share/henri-ui/"
plugins="$HOME/.config/omarchy/plugins"

[[ -d $src ]] || { echo "henri-ui-sync: $src missing" >&2; exit 1; }
# Motion.js imports Prefs.js; it must always exist.
[[ -e $src/Prefs.js || ! -e $src/Prefs.default.js ]] || cp "$src/Prefs.default.js" "$src/Prefs.js"

for marker in "$plugins"/*/henri-ui/.henri-ui-vendored "$HOME"/Projects/*/henri-ui/.henri-ui-vendored; do
  [[ -e $marker ]] || continue
  dest="$(dirname "$marker")/"
  rsync -a --delete --checksum \
    --exclude gallery/ --exclude .henri-ui-vendored --exclude /Prefs.js --exclude /Prefs.js.tmp \
    "$src" "$dest"
  [[ -e $dest/Prefs.js || ! -e $dest/Prefs.default.js ]] || cp "$dest/Prefs.default.js" "$dest/Prefs.js"
  # An installed plugin runs on this machine, so its copy must follow this
  # machine's switches (Reduce motion …), not the defaults it ships. Git is told
  # to ignore that local change (skip-worktree), so the defaults stay committed.
  if [[ $dest == "$plugins"/* && -e $src/Prefs.js ]] && ! cmp -s "$src/Prefs.js" "$dest/Prefs.js"; then
    cp "$src/Prefs.js" "$dest/Prefs.js"
    repo="$(dirname "$dest")"
    git -C "$repo" update-index --skip-worktree henri-ui/Prefs.js 2>/dev/null || true
  fi
  echo "henri-ui-sync: updated ${dest#"$HOME"/}"
done

# apple-ui tokens, for apps that vendor only Apple.js (marker .apple-ui-vendored)
for marker in "$plugins"/*/apple-ui/.apple-ui-vendored "$HOME"/Projects/*/apple-ui/.apple-ui-vendored; do
  [[ -e $marker ]] || continue
  dest="$(dirname "$marker")/"
  rsync -a --checksum "$HOME/.local/share/apple-ui/Apple.js" "$dest"
  echo "henri-ui-sync: updated ${dest#"$HOME"/}apple-ui"
done

[[ ${HENRI_UI_NO_RESTART:-0} == 1 ]] && exit 0

# Files that matter for a restart: everything but the Prefs.js machine state.
changed() { find -L "$src" "$HOME/.local/share/apple-ui/" -maxdepth 1 -type f ! -name 'Prefs.js' ! -name 'Prefs.js.tmp' "$@" -print -quit 2>/dev/null; }

# Only Prefs.js changed since the last run → System Settings restarts the shell.
if [[ -e $stamp && -z $(changed -newer "$stamp") ]]; then
  touch "$stamp"
  exit 0
fi

# Debounce: only restart once nothing in henri-ui changed for $quiet seconds.
while [[ -n $(changed -newermt "-$quiet seconds") ]]; do
  sleep 0.5
done
mkdir -p "$(dirname "$stamp")" && touch "$stamp"

restart="${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-restart-shell"
if quickshell list --all 2>/dev/null | grep -q 'omarchy/shell'; then
  "$restart" && echo "henri-ui-sync: shell restarted"
fi
