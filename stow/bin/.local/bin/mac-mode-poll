#!/bin/bash
# Polls the Mac's mac-mode status over SSH into a local file the control
# center plugin watches, so the panel never shells out at open time.
set -euo pipefail

DEST="$XDG_RUNTIME_DIR/mt-bridge"
mkdir -p "$DEST"

# Same two addresses, in the same order, as mac-do: the cable is dead in an
# instant when it is out, so trying it first costs nothing and tells us which
# link actually carries this round trip. That answer is the point -- the panel
# used to have no transport at all while the receiver was stopped and simply
# guessed "Wi-Fi", which is what made a perfectly good cable read as wireless.
MAC_USER=${MAC_USER:-henrischulz}
MAC_CABLE=${MAC_CABLE:-10.55.0.2}
MAC_WIFI=${MAC_WIFI:-192.168.178.126}

# Power over the cable rides on the same round trip: mac-power reconciles the
# Linux port role and says what the Mac does with the cable (on|off|battery);
# mt-charge on
# the Mac makes that true and reports charge=... back, so a Mac reboot (SMC
# keys reset) heals within one tick.
want=$("$HOME/.local/bin/mac-power" reconcile 2>/dev/null) || want=battery
[[ $want == on || $want == off || $want == battery ]] || want=battery

# Piggybacks a liveness check for mtsend onto the same round-trip: reachable
# over SSH says the Mac is awake, nothing about whether the bridge itself is
# running there, and the panel used to conflate the two.
remote="/Users/$MAC_USER/.local/bin/mac-mode status; \
pgrep -x mtsend >/dev/null && echo mtsend=1 || echo mtsend=0; \
/usr/local/bin/mt-charge ensure $want 2>/dev/null || echo charge=unknown"

out=""; host=""; transport=""
for h in "$MAC_CABLE" "$MAC_WIFI"; do
  if out=$(ssh -o ConnectTimeout=3 -o BatchMode=yes "$MAC_USER@$h" "$remote" 2>/dev/null); then
    host=$h
    [[ $h == "$MAC_CABLE" ]] && transport="USB-C" || transport="Wi-Fi"
    break
  fi
done
[[ -n $host ]] || exit 0

tmp=$(mktemp "$DEST/.macmode.XXXXXX")
{
  printf '%s\n' "$out"
  # Which link this round trip came back on. Only a fact about SSH, not about
  # the bridge -- but it is the honest answer to "where is the Mac right now"
  # whenever mtbridge is stopped and has no transport of its own to report.
  printf 'host=%s\ntransport=%s\n' "$host" "$transport"
} > "$tmp"
mv -f "$tmp" "$DEST/macmode"
