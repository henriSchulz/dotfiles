#!/bin/bash
# Workspaces 1–5 are fixed slots and are never renumbered. Above them, keep
# 6–10 free of gaps: with windows on 6, 8 and 9, the windows on 8 move to 7 and
# those on 9 move to 8. Runs as a listener on Hyprland's event
# socket and compacts whenever a window opens, closes or changes workspace, and
# whenever the focused workspace changes. The focused workspace keeps its slot
# while it is empty, so windows from higher workspaces only move down once you
# leave it; when the focused workspace's windows move, focus moves with them.
# After a workspace switch it waits for the slide animation to finish, and it
# renumbers the focused workspace without animation, since nothing visibly
# changes and a second slide would cut into the first.
#
#   hypr-workspace-compact          listen (started from hypr/autostart.lua)
#   hypr-workspace-compact --once   compact once and exit
set -euo pipefail

compact() {
  local state focused id addr target=6 follow="" lua=""
  state=$(hyprctl -j clients) || return 0
  focused=$(hyprctl -j activeworkspace | jq -r '.id') || return 0

  for id in $(jq -r --argjson f "$focused" '[(.[] | .workspace.id), $f | select(. >= 6 and . <= 10)] | unique | .[]' <<<"$state"); do
    if (( id == focused )) && ! jq -e --argjson ws "$id" 'any(.[]; .workspace.id == $ws)' <<<"$state" >/dev/null; then
      # Focused and empty: reserve its slot instead of filling it.
      target=$((id + 1))
      continue
    fi
    if (( id != target )); then
      for addr in $(jq -r --argjson ws "$id" '.[] | select(.workspace.id == $ws) | .address' <<<"$state"); do
        lua+="hl.dispatch(hl.dsp.window.move({ workspace = '$target', follow = false, window = 'address:$addr' })); "
      done
      (( id == focused )) && follow=$target
    fi
    target=$((target + 1))
  done

  [[ -n $lua ]] || return 0
  [[ -z $follow ]] && { hyprctl eval "$lua" >/dev/null || true; return 0; }

  # Renumber the focused workspace instantly, then restore its animation.
  local restore
  restore=$(hyprctl -j animations | jq -r '.[0][] | select(.name == "workspaces" and .overridden and .enabled)
    | "hl.animation({ leaf = \"workspaces\", enabled = true, speed = \(.speed), bezier = \"\(.bezier)\", style = \"\(.style)\" })"') || restore=""
  [[ -n $restore ]] && lua="hl.animation({ leaf = 'workspaces', enabled = false }); $lua"
  lua+="hl.dispatch(hl.dsp.focus({ workspace = '$follow' }))"
  hyprctl eval "$lua" >/dev/null || true
  [[ -n $restore ]] && { hyprctl eval "$restore" >/dev/null || true; }
  return 0
}

# Workspace slide duration (speed is in deciseconds) plus a little margin.
settle_delay() {
  hyprctl -j animations | jq -r '[.[0][] | select(.name == "workspaces" and .enabled) | .speed * 0.1 + 0.1] | first // 0.15' 2>/dev/null || echo 0.15
}

if [[ ${1:-} == --once ]]; then
  compact
  exit 0
fi

# One listener per Hyprland session.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/hypr-workspace-compact-$HYPRLAND_INSTANCE_SIGNATURE.lock"
flock -n 9 || exit 0

socket="${XDG_RUNTIME_DIR:-/tmp}/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
compact
is_switch() { [[ $1 == workspacev2\>\>* || $1 == focusedmonv2\>\>* ]]; }

socat -u "UNIX-CONNECT:$socket" - | while IFS= read -r event; do
  case $event in
    openwindow\>\>* | closewindow\>\>* | movewindowv2\>\>* | workspacev2\>\>* | focusedmonv2\>\>*)
      # Drain the rest of a burst (including our own moves) before compacting;
      # after a workspace switch, wait until its animation is done.
      delay=0.15
      is_switch "$event" && delay=$(settle_delay)
      while IFS= read -r -t "$delay" event; do
        is_switch "$event" && delay=$(settle_delay)
      done
      compact
      ;;
  esac
done
