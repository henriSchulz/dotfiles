#!/bin/bash
# Keep workspaces 1–10 free of gaps: with windows on 1, 3 and 4, the windows on
# 3 move to 2 and those on 4 move to 3. Runs as a listener on Hyprland's event
# socket and compacts whenever a window opens, closes or changes workspace.
# A focused empty workspace is left alone; when the focused workspace's windows
# move, focus moves with them.
#
#   hypr-workspace-compact          listen (started from hypr/autostart.lua)
#   hypr-workspace-compact --once   compact once and exit
set -euo pipefail

compact() {
  local state focused id addr target=1 follow="" lua=""
  state=$(hyprctl -j clients) || return 0
  focused=$(hyprctl -j activeworkspace | jq -r '.id') || return 0

  for id in $(jq -r '[.[] | .workspace.id | select(. >= 1 and . <= 10)] | unique | .[]' <<<"$state"); do
    if (( id != target )); then
      for addr in $(jq -r --argjson ws "$id" '.[] | select(.workspace.id == $ws) | .address' <<<"$state"); do
        lua+="hl.dispatch(hl.dsp.window.move({ workspace = '$target', follow = false, window = 'address:$addr' })); "
      done
      (( id == focused )) && follow=$target
    fi
    target=$((target + 1))
  done

  [[ -n $lua ]] || return 0
  [[ -n $follow ]] && lua+="hl.dispatch(hl.dsp.focus({ workspace = '$follow' }))"
  hyprctl eval "$lua" >/dev/null || true
}

if [[ ${1:-} == --once ]]; then
  compact
  exit 0
fi

# One listener per Hyprland session.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/hypr-workspace-compact-$HYPRLAND_INSTANCE_SIGNATURE.lock"
flock -n 9 || exit 0

socket="${XDG_RUNTIME_DIR:-/tmp}/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
compact
socat -u "UNIX-CONNECT:$socket" - | while IFS= read -r event; do
  case $event in
    openwindow\>\>* | closewindow\>\>* | movewindowv2\>\>*)
      # Drain the rest of a burst (including our own moves) before compacting.
      while IFS= read -r -t 0.15 _; do :; done
      compact
      ;;
  esac
done
