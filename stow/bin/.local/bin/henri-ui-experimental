#!/usr/bin/env python3
"""Switch the experimental macOS mode on or off.

One flag, read by everything that opts into the experiment:

  ~/.local/state/henri-ui/experimental        "on" or "off" — the flag itself
  ~/.local/state/henri-ui/experimental.css    what GTK4 apps pick up
  gsettings gtk-theme                         what GTK3 apps pick up

~/.config/gtk-4.0/gtk.css imports experimental.css before the henri-ui files,
so while the mode is on, the MacTahoe base theme (built by
henri-ui-mactahoe-build) styles every GTK4 app, and the henri-ui app styles
still override it where they have an opinion. While it is off the file is
empty and nothing changes.

GTK3 has no such user stylesheet, so it takes the whole theme instead:
gtk-theme is pointed at MacTahoe-Experimental and the previous name is kept
in experimental.prev-theme to go back to. That reaches evince, every GTK3
dialog and Chromium's file chooser. Quick Look is unaffected — Sushi starts
with GTK_THEME=HenriQuickLook, and the variable beats the setting.

GTK reads all of this at startup, so apps show the change the next time
they launch.

  henri-ui-experimental status|on|off|toggle [--rebuild]

Called by the Control Center (Experiments page) and usable on its own.
"""
import os
import subprocess
import sys
from pathlib import Path

home = Path.home()
state = Path(os.environ.get("XDG_STATE_HOME", home / ".local/state")) / "henri-ui"
flag = state / "experimental"
css = state / "experimental.css"
prev_theme = state / "experimental.prev-theme"
mactahoe = state / "vendor/mactahoe/gtk.css"
GTK3_THEME = "MacTahoe-Experimental"
gtk3_theme_dir = home / ".local/share/themes" / GTK3_THEME

HEADER = "/* Generated by henri-ui-experimental. Do not edit. */\n"


def is_on():
    try:
        return flag.read_text().strip() == "on"
    except OSError:
        return False


def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text)
    tmp.replace(path)


def gsettings(*args):
    try:
        r = subprocess.run(["gsettings", *args], capture_output=True, text=True)
        return r.stdout.strip().strip("'")
    except OSError:
        return ""


def set_gtk3_theme(on):
    """Point GTK3 at the built theme, or put the old name back."""
    current = gsettings("get", "org.gnome.desktop.interface", "gtk-theme")
    if on:
        if not (gtk3_theme_dir / "gtk-3.0/gtk.css").exists():
            print("henri-ui-experimental: no GTK3 theme built, leaving gtk-theme alone",
                  file=sys.stderr)
            return
        # Only remember a name that is not already ours, so switching on twice
        # cannot lose the original.
        if current and current != GTK3_THEME:
            write(prev_theme, current + "\n")
        gsettings("set", "org.gnome.desktop.interface", "gtk-theme", GTK3_THEME)
    elif current == GTK3_THEME:
        try:
            back = prev_theme.read_text().strip()
        except OSError:
            back = "Adwaita"
        gsettings("set", "org.gnome.desktop.interface", "gtk-theme", back or "Adwaita")


def build():
    try:
        subprocess.run(["henri-ui-mactahoe-build"], check=True)
        return True
    except (OSError, subprocess.CalledProcessError) as e:
        print(f"henri-ui-experimental: build failed ({e})", file=sys.stderr)
        return False


def apply(on, rebuild=False):
    if on and (rebuild or not mactahoe.exists()) and not build():
        on = False
    write(flag, "on\n" if on else "off\n")
    write(css, HEADER + (f'@import url("file://{mactahoe}");\n' if on
                         else "/* experimental macOS mode is off */\n"))
    set_gtk3_theme(on)
    return on


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    rebuild = "--rebuild" in sys.argv[1:]
    action = args[0] if args else "status"

    if action == "status":
        # Keep the imported file present even before the mode is first used,
        # so GTK never logs a missing-import error.
        if not css.exists():
            apply(is_on())
        print("on" if is_on() else "off")
        return 0 if is_on() else 1

    if action not in ("on", "off", "toggle"):
        print("usage: henri-ui-experimental status|on|off|toggle [--rebuild]",
              file=sys.stderr)
        return 2

    target = True if action == "on" else False if action == "off" else not is_on()
    on = apply(target, rebuild)
    print("on" if on else "off")
    return 0 if on == target else 1


if __name__ == "__main__":
    sys.exit(main())
