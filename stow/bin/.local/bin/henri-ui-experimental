#!/usr/bin/env python3
"""Switch the experimental macOS mode on or off.

It styles the shell — every Quickshell plugin at once. henri-ui/Experimental.js
holds one flag and a table of Tahoe values; Motion.js applies them over its own
tokens while the flag is set, and every plugin imports Motion.js. So bar popups,
menus, Control Center, Spotlight, Mission Control, the switcher and the HUD all
change shape together.

  ~/.local/share/henri-ui/Experimental.js   the flag and the table
  ~/.local/state/henri-ui/experimental      "on"/"off", what the panel reads

Flipping the flag writes into the central henri-ui folder, which henri-ui-sync
watches: it mirrors the change into the plugins that vendor their own copy and
restarts the shell about two seconds later. That restart is not optional — the
shell keeps already-loaded henri-ui components cached, so a hot reload alone
would leave half the surfaces on the old numbers.

  henri-ui-experimental status|on|off|toggle

Called by the Control Center (Experiments page) and usable on its own.
"""
import os
import re
import sys
from pathlib import Path

home = Path.home()
state = Path(os.environ.get("XDG_STATE_HOME", home / ".local/state")) / "henri-ui"
flag = state / "experimental"
script = home / ".local/share/henri-ui/Experimental.js"


def is_on():
    """Ask the file the shell actually reads, not the state copy."""
    try:
        return re.search(r"^var on = (\w+)", script.read_text(), re.M).group(1) == "true"
    except (OSError, AttributeError):
        return False


def apply(on):
    try:
        text = script.read_text()
    except OSError:
        print(f"henri-ui-experimental: {script} is missing — the shell needs it",
              file=sys.stderr)
        return False

    new, count = re.subn(r"^var on = \w+$", f"var on = {str(on).lower()}",
                         text, count=1, flags=re.M)
    if not count:
        print(f"henri-ui-experimental: no 'var on' line in {script.name}",
              file=sys.stderr)
        return False
    if new != text:
        # Written in place: the folder is a stow symlink, and replacing the
        # file through a temp name would be one more event for the path unit.
        script.write_text(new)

    state.mkdir(parents=True, exist_ok=True)
    (state / "experimental").write_text("on\n" if on else "off\n")
    return on


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else "status"

    if action == "status":
        print("on" if is_on() else "off")
        return 0 if is_on() else 1

    if action not in ("on", "off", "toggle"):
        print("usage: henri-ui-experimental status|on|off|toggle", file=sys.stderr)
        return 2

    target = True if action == "on" else False if action == "off" else not is_on()
    ok = apply(target)
    print("on" if ok else "off")
    return 0 if ok == target else 1


if __name__ == "__main__":
    sys.exit(main())
