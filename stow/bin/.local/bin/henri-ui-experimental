#!/usr/bin/env python3
"""Switch the experimental macOS mode on or off.

One flag, read by everything that opts into the experiment:

  ~/.local/state/henri-ui/experimental        "on" or "off" — the flag itself
  ~/.local/state/henri-ui/experimental.css    what GTK4 apps pick up

~/.config/gtk-4.0/gtk.css imports experimental.css before the henri-ui files,
so while the mode is on, the MacTahoe base theme (built by
henri-ui-mactahoe-build) styles every GTK4 app, and the henri-ui app styles
still override it where they have an opinion. While it is off the file is
empty and nothing changes. GTK reads its stylesheet at startup, so apps show
the change the next time they launch.

  henri-ui-experimental status|on|off|toggle [--rebuild]

Called by the Control Center (Experiments page) and usable on its own.
"""
import os
import subprocess
import sys
from pathlib import Path

home = Path.home()
state = Path(os.environ.get("XDG_STATE_HOME", home / ".local/state")) / "henri-ui"
flag = state / "experimental"
css = state / "experimental.css"
mactahoe = state / "vendor/mactahoe/gtk.css"

HEADER = "/* Generated by henri-ui-experimental. Do not edit. */\n"


def is_on():
    try:
        return flag.read_text().strip() == "on"
    except OSError:
        return False


def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text)
    tmp.replace(path)


def build():
    try:
        subprocess.run(["henri-ui-mactahoe-build"], check=True)
        return True
    except (OSError, subprocess.CalledProcessError) as e:
        print(f"henri-ui-experimental: build failed ({e})", file=sys.stderr)
        return False


def apply(on, rebuild=False):
    if on and (rebuild or not mactahoe.exists()) and not build():
        on = False
    write(flag, "on\n" if on else "off\n")
    write(css, HEADER + (f'@import url("file://{mactahoe}");\n' if on
                         else "/* experimental macOS mode is off */\n"))
    return on


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    rebuild = "--rebuild" in sys.argv[1:]
    action = args[0] if args else "status"

    if action == "status":
        # Keep the imported file present even before the mode is first used,
        # so GTK never logs a missing-import error.
        if not css.exists():
            apply(is_on())
        print("on" if is_on() else "off")
        return 0 if is_on() else 1

    if action not in ("on", "off", "toggle"):
        print("usage: henri-ui-experimental status|on|off|toggle [--rebuild]",
              file=sys.stderr)
        return 2

    target = True if action == "on" else False if action == "off" else not is_on()
    on = apply(target, rebuild)
    print("on" if on else "off")
    return 0 if on == target else 1


if __name__ == "__main__":
    sys.exit(main())
