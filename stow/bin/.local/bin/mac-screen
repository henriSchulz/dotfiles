#!/bin/sh
# Use this machine as a display for the screenless MacBook.
#
#   mac-screen            # the Mac's screen, filling this one edge to edge
#   mac-screen --exact    # pixel for pixel, black bars where sizes differ
#   mac-screen --control  # also send keyboard and mouse to the Mac
#   mac-screen --window   # in a window rather than filling the screen
#   mac-screen --wifi     # force the wireless route
#   mac-screen --cable
#
# This is a screen, not a remote control: the session is view-only unless you
# ask otherwise. The Mac is driven from the Mac, and a stray click over here
# should not land over there.
#
# Set the Mac to a resolution with this screen's aspect ratio -- macres on the
# Mac does that -- and the picture fills the display exactly. 1440x900 against
# 1920x1200 is the same 16:10 and scales by a clean third, which also leaves
# the Mac a quarter of the pixels a Retina mode would have cost.
#
# Do not expect to see the Mac's pointer. Its screen sharing sends no cursor
# information to a standard VNC client at all -- not the shape, not the
# position -- because the protocol assumes whoever is watching is also the one
# moving it. Measured, not guessed. With --control the pointer is yours and
# therefore visible; watching, there is nothing to draw.
#
# macOS Screen Sharing only offers Apple's own authentication schemes by
# default, so the legacy VNC password is enabled on the Mac instead. That
# scheme is DES and worth nothing on its own -- which is why nothing connects
# to it directly: the session runs through an SSH tunnel keyed to this machine,
# and VNC only ever sees localhost.

set -e

MAC_USER=${MAC_USER:-henrischulz}
MAC_CABLE=${MAC_CABLE:-10.55.0.2}
MAC_WIFI=${MAC_WIFI:-192.168.178.126}
LPORT=${MAC_SCREEN_PORT:-5901}
# The filter sits between the scaling viewer and the tunnel; see below.
FPORT=${MAC_SCREEN_FILTER_PORT:-5902}
CONFDIR=${XDG_CONFIG_HOME:-$HOME/.config}/mt-bridge
MACPASS=${MAC_SCREEN_MACPASS:-$CONFDIR/macpass}
PASSFILE=${MAC_SCREEN_PASS:-$CONFDIR/vncpass}
PROFILE=$CONFDIR/mac-screen.remmina
CTL=$(mktemp -u "${XDG_RUNTIME_DIR:-/tmp}/mac-screen.XXXXXX")

SCALED=1
WINDOWED=0
CONTROL=0
# Fast by default: mirroring a Retina screen means the Mac captures and encodes
# four times the pixels of an ordinary display, and that is where the delay
# comes from. Colour depth is the cheapest thing to give up for a picture that
# keeps up; --rich puts it back.
FAST=1
FORCE=""
for a in "$@"; do
    case "$a" in
        --exact|--pixels) SCALED=0 ;;
        -w|--window) WINDOWED=1 ;;
        --control) CONTROL=1 ;;
        --rich|--quality) FAST=0 ;;
        --wifi)  FORCE=$MAC_WIFI ;;
        --cable) FORCE=$MAC_CABLE ;;
        -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    esac
done

die() { echo "mac-screen: $*" >&2; exit 1; }

# A tunnel left behind by an earlier run holds its port, and binding then fails
# with nothing on screen to explain why. Rather than making that the user's
# problem, move along until something is free.
free_port() {
    p=$1
    while [ "$p" -lt $(($1 + 20)) ]; do
        timeout 1 sh -c "echo > /dev/tcp/127.0.0.1/$p" 2>/dev/null || { echo "$p"; return; }
        p=$((p + 1))
    done
    echo "$1"
}

reachable() {
    # A short TCP probe rather than ping: what matters is that sshd answers,
    # not that the address replies.
    timeout 2 sh -c "echo > /dev/tcp/$1/22" 2>/dev/null
}

if [ -n "$FORCE" ]; then
    HOST=$FORCE; ROUTE=$FORCE
    reachable "$HOST" || die "$HOST does not answer on port 22"
elif reachable "$MAC_CABLE"; then
    HOST=$MAC_CABLE; ROUTE="cable"
elif reachable "$MAC_WIFI"; then
    HOST=$MAC_WIFI; ROUTE="Wi-Fi"
else
    die "the Mac answers on neither $MAC_CABLE nor $MAC_WIFI
  is it awake, and is the cable in? check: systemctl status ncmlink"
fi
LPORT=$(free_port "$LPORT")
FPORT=$(free_port "$FPORT")
[ "$FPORT" = "$LPORT" ] && FPORT=$((LPORT + 1))
echo "mac-screen: $ROUTE -> $HOST"

VIEWER=""
FILTER=""
# Every step ends in `|| true`: this runs under `set -e`, and a viewer that has
# already exited makes kill fail, which would otherwise abort the function
# right here and leave the tunnel holding the port.
cleanup() {
    if [ -n "$VIEWER" ]; then kill "$VIEWER" 2>/dev/null || true; fi
    if [ -n "$FILTER" ]; then kill "$FILTER" 2>/dev/null || true; fi
    ssh -S "$CTL" -O exit "$MAC_USER@$HOST" 2>/dev/null || true
    rm -f "$CTL" || true
}
trap cleanup EXIT INT TERM

# ExitOnForwardFailure so a port already in use fails here, loudly, instead of
# leaving the viewer to connect to whatever else is listening on it.
ssh -f -N -M -S "$CTL" -o ExitOnForwardFailure=yes -o ConnectTimeout=5 \
    -L "$LPORT:127.0.0.1:5900" "$MAC_USER@$HOST" \
    || die "could not open the tunnel (is port $LPORT already in use?)"

# Both viewers go through the filter: it logs in as the console user, which is
# what puts this on the desktop already in use rather than on a session of its
# own, and hands over a connection that needs no negotiating.
if [ -f "$MACPASS" ]; then
    vnc-pin-auth --listen "$FPORT" --target "127.0.0.1:$LPORT" \
                 --user "$MAC_USER" --macpass "$MACPASS" >/dev/null 2>&1 &
else
    printf 'Mac password for %s (not stored, kept in memory): ' "$MAC_USER" >&2
    stty -echo 2>/dev/null; read -r MACPW; stty echo 2>/dev/null; echo >&2
    printf '%s\n' "$MACPW" | vnc-pin-auth --listen "$FPORT" \
                 --target "127.0.0.1:$LPORT" --user "$MAC_USER" \
                 --macpass - >/dev/null 2>&1 &
    MACPW=
fi
FILTER=$!
sleep 0.5

if [ "$SCALED" -eq 0 ]; then
    VO=1
    [ "$CONTROL" -eq 1 ] && VO=0
    FS=0
    [ "$WINDOWED" -eq 0 ] && FS=1
    # AlwaysCursor draws something where the pointer is even when the server
    # reports an invisible one, so the cursor never simply goes missing.
    # FullscreenSystemKeys off: in fullscreen the viewer otherwise grabs the
    # keyboard, and a window that only shows a picture has no business
    # swallowing this machine's own shortcuts.
    vncviewer -SecurityTypes None -ViewOnly=$VO -FullScreen=$FS \
              -FullscreenSystemKeys=0 -AlwaysCursor=1 \
              -QualityLevel 9 -CompressLevel 1 \
              -Shared=1 -ReconnectOnError=0 "127.0.0.1:$FPORT" &
else
    mkdir -p "$CONFDIR"

    VIEWONLY=1
    [ "$CONTROL" -eq 1 ] && VIEWONLY=0
    VIEWMODE=4
    [ "$WINDOWED" -eq 1 ] && VIEWMODE=1
    SCALEQ=1; QUALITY=9; DEPTH=32
    if [ "$FAST" -eq 1 ]; then
        SCALEQ=0; QUALITY=5; DEPTH=16
    fi

    cat > "$PROFILE" <<PROFILEEOF
[remmina]
name=MacBook
group=
protocol=VNC
server=127.0.0.1:$FPORT
username=
scale=1
scale_quality=$SCALEQ
quality=$QUALITY
colordepth=$DEPTH
showcursor=0
viewonly=$VIEWONLY
disableserverinput=0
viewmode=$VIEWMODE
window_maximize=1
PROFILEEOF
    remmina -c "$PROFILE" &
fi

VIEWER=$!
# Backgrounded and waited on rather than run in the foreground: a shell waiting
# on a foreground child defers its traps until that child is done, so a signal
# would clean up nothing and leave the tunnel holding the port.
wait "$VIEWER"
