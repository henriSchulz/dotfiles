#!/bin/bash
# mac-do -- the Mac operations from Control Center → Mac as one-shot commands,
# for Spotlight (henri.menu) and the shell. Every operation answers with a
# notification, because a Spotlight row has no panel to show the outcome in.
#
#   mac-do input on|off|toggle        trackpad + keyboard from the MacBook (mtbridge)
#   mac-do screen on|off|toggle       the MacBook's screen on this one (mac-stream)
#   mac-do mode auto|server|desktop   the Mac's server/desktop mode (mac-mode there)
#   mac-do power on|off|toggle        power over the cable (mac-power to-mac|off)
#   mac-do battery                    charge level now, and pull the history
#   mac-do status                     one notification with where everything stands
#   mac-do airplay                    mirror over AirPlay instead (mac-mirror, slow)
#   mac-do vnc                        VNC screen for the login window (mac-screen)
#   mac-do is input|screen|power      exit 0 when on -- Spotlight's `checked:` guards
#   mac-do is mode <auto|server|desktop>
#
# `is` only reads the status files the daemons keep under $XDG_RUNTIME_DIR/
# mt-bridge (the same ones the control-center panel watches) and never touches
# the network: the menu runs every guard each time it opens, and an SSH round
# trip there would be the delay between Super+Space and the list.
#
# The waits mirror what the panel does while its switch says "Connecting …":
# the daemons are started and the status file is watched until it agrees, so
# the notification reports what actually happened rather than what was asked.
set -uo pipefail

RUN=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/mt-bridge
BATTERY_DIR=$HOME/.local/share/mt-bridge/battery
MAC_USER=${MAC_USER:-henrischulz}
MAC_CABLE=${MAC_CABLE:-10.55.0.2}
MAC_WIFI=${MAC_WIFI:-192.168.178.126}
MAC_MODE_BIN=/Users/$MAC_USER/.local/bin/mac-mode

# ---- notifications ----------------------------------------------------------
# One notification per operation: the first call creates it ("Connecting …"),
# later calls replace it in place, so the banner turns into the result instead
# of a second one stacking on top. Results are transient (gone from the centre
# once dismissed); failures stay, because they are the ones worth reading later.
APP="Mac"
GLYPH=$'\U000f0322'   # nf-md-laptop, drawn in the theme font by henri.notifications
NID=""
notify() {
  local args=(-a "$APP" -h "string:omarchy-glyph:$GLYPH" -p)
  [[ -n $NID ]] && args+=(-r "$NID")
  [[ ${3:-} == keep ]] || args+=(-e)
  NID=$(notify-send "${args[@]}" -- "$1" "${2:-}" 2>/dev/null) || NID=""
}
fail() { notify "$1" "${2:-}" keep; exit 1; }

# ---- status files -----------------------------------------------------------
now() { date +%s; }
kv() { [[ -f $1 ]] || return 1; sed -n "s/^$2=//p" "$1" | head -n1; }
fresh() { local u; u=$(kv "$1" updated) || return 1; [[ -n $u ]] && (( $(now) - u < $2 )); }
recent() { local v; v=$(kv "$1" "$2") || return 1; [[ -n $v && $v != 0 ]] && (( $(now) - v < $3 )); }

input_linked()    { fresh "$RUN/status" 4 && [[ $(kv "$RUN/status" linked) == 1 ]]; }
input_streaming() { input_linked && recent "$RUN/status" last_packet 3; }
input_transport() { kv "$RUN/status" transport; }
# transport is the best link the Mac answers on; stream is the one frames are
# really arriving over, and is empty while nothing is. Prefer the second when
# there is one, because that is the question somebody looking at a live
# pointer is actually asking.
input_stream()    { kv "$RUN/status" stream; }
input_reachable() { kv "$RUN/status" reachable; }
input_route()     { local r; r=$(input_stream); [[ -n $r ]] || r=$(input_transport); echo "$r"; }
mac_sender_alive() { mode_fresh && [[ $(kv "$RUN/macmode" mtsend) == 1 ]]; }

# The sender pings on a timer whether or not it is capturing, so `linked`
# only ever proved the process was alive over there. This is the question
# that actually matters: is it reading the trackpad. A sender too old to say
# reports "unknown", and then the weaker old proof is all there is.
input_sender()      { kv "$RUN/status" sender; }
input_capturing()   { input_linked && [[ $(input_sender) == capturing ]]; }
input_sender_says() { local v; v=$(input_sender); [[ $v == capturing || $v == idle ]]; }
input_really_on()   { if input_sender_says; then input_capturing; else input_linked; fi; }

# The LaunchAgent is what puts mtsend inside the logged-in desktop session;
# kickstart is the only door in from SSH, which has no window server of its
# own. Without -k, so a sender that is already running is left alone.
mac_sender_start()      { mac_ssh 'launchctl kickstart gui/$(id -u)/com.mtbridge.mtsend' >/dev/null 2>&1; }
# On and off, not toggle: a toggle sent over a network cannot be made
# idempotent, and a lost reply would leave the two ends disagreeing.
mac_sender_activate()   { mac_ssh pkill -USR1 -x mtsend >/dev/null 2>&1; }
mac_sender_deactivate() { mac_ssh pkill -USR2 -x mtsend >/dev/null 2>&1; }
input_service()   { systemctl --user is-active --quiet mtbridge; }
screen_on()       { fresh "$RUN/screen" 6; }
mode_fresh()      { fresh "$RUN/macmode" 40; }
mode_pin()        { local p; p=$(kv "$RUN/macmode" pin); echo "${p:-auto}"; }
power_mode()      { local m; m=$(kv "$RUN/power" mode) || m=$(kv "$HOME/.local/state/henri/mac-power" mode); echo "${m:-off}"; }
cap()             { printf '%s' "${1^}"; }

# Try the cable first (dead in an instant when it is out), then Wi-Fi. Only a
# connection failure (255) moves on; a command that ran and failed is final.
mac_ssh() {
  local host rc
  for host in "$MAC_CABLE" "$MAC_WIFI"; do
    ssh -o ConnectTimeout=3 -o BatchMode=yes "$MAC_USER@$host" "$@"; rc=$?
    [[ $rc == 255 ]] || return $rc
  done
  return 255
}

wait_for() { # seconds check...
  local deadline=$(( $(date +%s%N) / 1000000 + $1 * 1000 )); shift
  until "$@"; do
    (( $(date +%s%N) / 1000000 >= deadline )) && return 1
    sleep 0.25
  done
}

# The Mac half of mode and power rides on mac-mode-poll's round trip. Starting
# the unit is not enough to know it ran (mac-power already queued one with
# --no-block, and a queued start returns at once), so wait for the file to be
# rewritten instead -- its mtime, because the `updated=` inside is the Mac's
# own tick time and only moves every half minute.
poll_mac() {
  local t0; t0=$(date +%s%3N)
  systemctl --user start mac-mode-poll.service 2>/dev/null
  wait_for 8 macmode_written_since "$t0"
}
macmode_written_since() { local m; m=$(stat -c %.3Y "$RUN/macmode" 2>/dev/null) || return 1; (( ${m/./} >= $1 )); }

# ---- descriptions, worded as the panel words them --------------------------
power_text() {
  local mode=$1 linux charge soc charging
  linux=$(kv "$RUN/power" linux); charge=$(kv "$RUN/macmode" charge)
  soc=$(kv "$RUN/macmode" soc); charging=$(kv "$RUN/macmode" charging)
  soc=${soc:+ · $soc %}
  case "$linux" in needs-install|needs-sudo) echo "Helper not installed on this machine"; return ;; esac
  case "$mode" in
    off)
      case "$charge" in
        battery) echo "Off · Mac on its own battery$soc" ;;
        guard) echo "Off · Mac battery was low, topping up to 40 %$soc" ;;
        normal|inhibited) echo "Off · waiting for the Mac to let go" ;;
        *) [[ $linux == no-mac ]] && echo "Off · no cable" || echo "Off" ;;
      esac ;;
    to-mac)
      if [[ $linux == no-mac ]]; then echo "Linux → Mac · no cable"
      elif [[ $charge == normal ]]; then [[ $charging == Yes ]] && echo "Linux → Mac · charging" || echo "Linux → Mac · 5 V / 3 A"
      elif [[ $charge == inhibited ]]; then echo "Linux → Mac · waiting for the Mac"
      else echo "Linux → Mac"; fi ;;
    *) [[ $(kv "$RUN/power" role) == sink ]] && echo "Mac → Linux · 15 W at most" || echo "Mac → Linux · swapping roles" ;;
  esac
}

mode_text() {
  local pin mode displays
  pin=$(mode_pin); mode=$(kv "$RUN/macmode" mode); displays=$(kv "$RUN/macmode" displays)
  if ! mode_fresh; then echo "Unreachable"; return; fi
  if [[ $pin == auto ]]; then
    echo "$(cap "${mode:-server}") · Auto · ${displays:-0} display$([[ ${displays:-0} == 1 ]] || echo s) detected"
  else
    echo "$(cap "$mode") · Forced"
  fi
}

battery_text() {
  local soc charging
  soc=$(kv "$RUN/macmode" soc); charging=$(kv "$RUN/macmode" charging)
  [[ -n $soc ]] || { echo "unknown"; return; }
  echo "$soc %$([[ $charging == Yes ]] && echo " · charging")"
}

overall_text() {
  local route
  route=$(input_route)
  [[ -n $route ]] || route=$(kv "$RUN/screen" route)
  # With the receiver stopped there is no transport of our own; mac-mode-poll
  # records which address its round trip came back on, which is the honest
  # answer. It used to say "Wi-Fi" flatly and was wrong whenever the cable
  # was in.
  [[ -n $route ]] || { mac_sender_alive && route=$(kv "$RUN/macmode" transport); }
  if input_streaming || screen_on; then echo "Connected${route:+ over $route}"
  elif input_service && ! input_linked; then echo "Connecting …"
  elif input_capturing; then echo "Idle${route:+ · $route}"
  elif input_linked && [[ $(input_sender) == idle ]]; then echo "Mac ready · not capturing"
  elif input_linked; then echo "Idle${route:+ · $route}"
  # Nothing may read as a working link unless both halves have spoken to each
  # other. "Idle" used to cover the case where sshd merely found an mtsend
  # process, which says nothing about a handshake -- so each half-open state
  # now names the half that is missing.
  elif mac_sender_alive; then
    if input_service; then echo "No answer${route:+ · $route}"
    else echo "Receiver off${route:+ · $route}"; fi
  elif mode_fresh; then echo "Bridge off on the Mac"
  else echo "Offline"; fi
}

# ---- operations -------------------------------------------------------------
input_on() {
  if input_really_on; then notify "Mac input is on" "Trackpad and keyboard arrive over $(input_route)."; return; fi
  systemctl --user start mtbridge
  notify "Connecting Mac input …" "Waiting for the MacBook to answer."

  # Starting the receiver here and hoping was the whole of this before, which
  # left the switch on with nothing running on the Mac to answer it. Start the
  # sender over there too.
  mac_sender_start
  if ! wait_for 15 input_linked; then
    fail "Mac input didn't connect" "No answer from the MacBook. The receiver keeps listening -- check that the Mac is awake and mt-bridge runs there."
    return
  fi

  # Linked only means the process is there. It can sit in --wait with nothing
  # grabbed and nothing read, which is exactly the state that used to show up
  # here as a working connection.
  if ! input_really_on; then
    mac_sender_activate
    if ! wait_for 8 input_really_on; then
      fail "The Mac answers but isn't capturing" "mtsend is running there and did not start reading the trackpad. Check ~/Library/Logs/mtbridge.log on the Mac."
      return
    fi
  fi
  notify "Mac input on" "Trackpad and keyboard arrive over $(input_route)."
}

input_off() {
  if ! input_service && ! input_linked; then notify "Mac input is off" ""; return; fi
  # Turning the receiver off while the Mac is still grabbed would trap its own
  # pointer and keyboard there with nowhere to send them: release it first.
  # This used to send SIGUSR1, which mtsend had no handler for -- so the
  # "release" killed the sender outright, and turning input off here was how
  # the app died over there.
  input_linked && mac_sender_deactivate
  systemctl --user stop mtbridge
  notify "Mac input off" "Trackpad and keyboard stay with the Mac."
}

screen_start() {
  if screen_on; then notify "Mac screen is on" "Mirroring over $(kv "$RUN/screen" route)."; return; fi
  omarchy-launch-or-focus gst-launch-1.0 'setsid -f mac-stream' >/dev/null 2>&1
  notify "Starting Mac screen …" "Asking the MacBook for its picture."
  if wait_for 12 screen_on; then
    notify "Mac screen on" "Over $(kv "$RUN/screen" route) from $(kv "$RUN/screen" host)."
  else
    fail "Mac screen didn't start" "No picture from the MacBook. Is it awake, and is mtscreen running there?"
  fi
}

screen_stop() {
  if ! screen_on; then notify "Mac screen is off" ""; return; fi
  kill "$(kv "$RUN/screen" pid)" 2>/dev/null
  notify "Mac screen off" ""
}

mode_set() {
  local want=$1
  notify "Switching the Mac to $(cap "$want") …" ""
  mac_ssh "$MAC_MODE_BIN" set "$want" >/dev/null 2>&1 \
    || fail "Couldn't reach the Mac" "No answer over the cable or Wi-Fi. Is the MacBook awake?"
  poll_mac
  notify "Mac mode: $(cap "$(kv "$RUN/macmode" mode)")" "$(mode_text)"
}

power_set() {
  local want=$1 linux
  notify "Applying power over the cable …" ""
  linux=$(mac-power set "$want" 2>/dev/null | sed -n 's/^linux=//p')
  case "$linux" in
    needs-install|needs-sudo) fail "Power helper not installed" "Run install/93-mac-power.sh on this machine (it needs your password) and try again." ;;
    swap-refused) fail "The port refused to swap roles" "The Mac kept its power role. Re-plug the cable and try again." ;;
  esac
  poll_mac
  if [[ $want == off ]]; then notify "Power over the cable off" "$(power_text off)"
  else notify "Power over the cable on" "$(power_text to-mac)"; fi
}

battery() {
  systemctl --user start mac-battery-sync.service 2>/dev/null
  local latest line t st
  latest=$(ls -t "$BATTERY_DIR"/*.csv 2>/dev/null | head -n1)
  [[ -n $latest ]] && line=$(tail -n1 "$latest") && IFS=, read -r t st _ <<<"$line"
  local level; level=$(battery_text)
  [[ $level == unknown ]] && fail "Mac battery unknown" "The Mac hasn't answered recently, so there is no fresh reading."
  notify "Mac battery $level" "${st:+$st · }history synced${t:+ up to $t}."
}

status() {
  local input screen
  if input_streaming; then input="on · over $(input_transport)"
  elif input_linked; then input="idle · $(input_transport)"
  elif input_service; then input="connecting"
  else input="off"; fi
  screen_on && screen="on · over $(kv "$RUN/screen" route)" || screen="off"
  # Four lines: the banner shows no more than that.
  notify "Mac · $(overall_text)" \
    "Input $input · Screen $screen"$'\n'"Mode $(mode_text)"$'\n'"Power $(power_text "$(power_mode)")"$'\n'"Battery $(battery_text)"
}

# Long-running viewers: hand them their own session and only speak up if they
# die on the spot -- the window is the success message.
airplay() {
  notify "Starting AirPlay mirroring …" "This drives the Mac's Control Centre and takes up to a minute."
  ( setsid -f bash -c 'mac-mirror; rc=$?; (( rc == 0 )) || notify-send -a "Mac" -h "string:omarchy-glyph:'"$GLYPH"'" -- "AirPlay mirroring failed" "mac-mirror exited with status $rc. See journalctl --user for uxplay."' ) &
  disown
}

vnc() {
  ( setsid -f bash -c 'mac-screen; rc=$?; (( rc == 0 )) || notify-send -a "Mac" -h "string:omarchy-glyph:'"$GLYPH"'" -- "VNC screen failed" "mac-screen exited with status $rc. Is the Mac reachable and Screen Sharing on?"' ) &
  disown
}

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

case "${1:-}" in
  input)
    case "${2:-toggle}" in
      on) input_on ;; off) input_off ;;
      toggle) if input_service; then input_off; else input_on; fi ;;
      *) usage 2 ;;
    esac ;;
  screen)
    case "${2:-toggle}" in
      on) screen_start ;; off) screen_stop ;;
      toggle) if screen_on; then screen_stop; else screen_start; fi ;;
      *) usage 2 ;;
    esac ;;
  mode)
    case "${2:-}" in auto|server|desktop) mode_set "$2" ;; *) usage 2 ;; esac ;;
  power)
    case "${2:-toggle}" in
      on) power_set to-mac ;; off) power_set off ;;
      toggle) if [[ $(power_mode) == off ]]; then power_set to-mac; else power_set off; fi ;;
      *) usage 2 ;;
    esac ;;
  battery) battery ;;
  status) status ;;
  airplay) airplay ;;
  vnc) vnc ;;
  is)
    case "${2:-}" in
      input) input_linked ;;
      screen) screen_on ;;
      power) [[ $(power_mode) != off ]] ;;
      mode) [[ $(mode_pin) == "${3:-}" ]] ;;
      *) usage 2 ;;
    esac ;;
  -h|--help|help) usage ;;
  *) usage 2 ;;
esac
