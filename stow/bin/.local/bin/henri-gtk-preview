#!/usr/bin/env python3
"""Screenshot GTK widgets or a whole app without anything showing on screen.

For checking GTK styling (gtk-4.0/gtk.css, the experimental macOS mode, a
theme switch) while the desktop is in use.

  henri-gtk-preview [out.png]                  GTK4 widget sheet
  henri-gtk-preview --gtk3 [out.png]           GTK3 widget sheet
  henri-gtk-preview --app nautilus [out.png]   a real app

Default output: ~/Downloads/gtk-preview.png

How it stays off screen: Hyprland gets a throwaway headless output and the
app is launched onto that output's workspace. Two things are easy to get
wrong here:

  * `hyprctl keyword windowrulev2 …` does nothing on this machine — the Lua
    config has no legacy parser ("keyword can't work with non-legacy
    parsers"), and hyprctl says so on stdout without failing, so the window
    quietly opens on whatever the user is looking at. Rules go through
    `hyprctl eval "hl.exec_cmd(cmd, { workspace = '<id> silent' })"`, which
    also scopes them to this one launch, so there is nothing to undo.
  * `grim -o HEADLESS-n` comes back with an empty desktop: Hyprland
    composites only layer surfaces (bar, wallpaper) on a headless output,
    never the windows. Capture the toplevel itself with `grim -T <stableId>`.

GTK3 needs none of this — it still has Gtk.OffscreenWindow.
"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path

TITLE = "henri-gtk-preview"
WIDTH, HEIGHT = 760, 460
DEFAULT_OUT = Path.home() / "Downloads/gtk-preview.png"


def hypr(*args, parse=False):
    out = subprocess.run(["hyprctl", *(["-j"] if parse else []), *args],
                         capture_output=True, text=True)
    return json.loads(out.stdout) if parse else out.stdout


def make_output():
    """A headless monitor and the workspace Hyprland gives it."""
    before = {m["name"] for m in hypr("monitors", "all", parse=True)}
    subprocess.run(["hyprctl", "output", "create", "headless"],
                   stdout=subprocess.DEVNULL)
    for _ in range(60):
        mons = {m["name"]: m for m in hypr("monitors", "all", parse=True)}
        new = set(mons) - before
        if new:
            name = new.pop()
            ws = (mons[name].get("activeWorkspace") or {}).get("id")
            if ws:
                return name, ws
        time.sleep(0.1)
    sys.exit("henri-gtk-preview: Hyprland did not create a headless output")


def launch(command, ws, size=None):
    """Start a command straight onto that workspace, never on a real screen."""
    opts = [f"workspace = '{ws} silent'", "float = true"]
    if size:
        opts.append(f"size = '{size}'")
    lua = "hl.exec_cmd('{}', {{ {} }})".format(
        command.replace("\\", "\\\\").replace("'", "\\'"), ", ".join(opts))
    result = hypr("eval", lua).strip()
    if not result.startswith("ok"):
        sys.exit(f"henri-gtk-preview: Hyprland refused the launch: {result}")


def wait_for_window(ws, match, timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        for c in hypr("clients", parse=True):
            if c["workspace"]["id"] != ws or not c["mapped"]:
                continue
            if match.lower() in f"{c['class']} {c['title']}".lower():
                return c
        time.sleep(0.15)
    return None


# ── the widget sheets ───────────────────────────────────────────────────────

def gtk4_sheet(out):
    """Runs in the child, on the headless workspace, and snapshots itself."""
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Gsk", "4.0")
    from gi.repository import GLib, Gsk, Gtk

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

    head = Gtk.HeaderBar()
    head.set_title_widget(Gtk.Label(label="Documents"))
    head.pack_start(Gtk.Button(icon_name="go-previous-symbolic"))
    head.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic"))
    head.pack_end(Gtk.Button(icon_name="edit-find-symbolic"))
    box.append(head)

    body = Gtk.Box()
    side = Gtk.ListBox()
    side.add_css_class("navigation-sidebar")
    for name in ("Home", "Recent", "Starred", "Trash"):
        row = Gtk.ListBoxRow()
        row.set_child(Gtk.Label(label=name, xalign=0))
        side.append(row)
    side.select_row(side.get_row_at_index(0))
    body.append(side)

    col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    col.set_hexpand(True)
    for edge in ("top", "bottom", "start", "end"):
        getattr(col, f"set_margin_{edge}")(16)

    buttons = Gtk.Box(spacing=8)
    for label, css in (("Suggested", "suggested-action"), ("Cancel", None),
                       ("Destructive", "destructive-action")):
        b = Gtk.Button(label=label)
        if css:
            b.add_css_class(css)
        buttons.append(b)
    col.append(buttons)

    controls = Gtk.Box(spacing=12)
    switch = Gtk.Switch()
    switch.set_active(True)
    switch.set_valign(Gtk.Align.CENTER)
    controls.append(switch)
    check = Gtk.CheckButton(label="Checkbox")
    check.set_active(True)
    controls.append(check)
    radio = Gtk.CheckButton(label="Radio")
    radio.set_group(Gtk.CheckButton())
    radio.set_active(True)
    controls.append(radio)
    col.append(controls)

    entry = Gtk.Entry()
    entry.set_placeholder_text("Search documents")
    col.append(entry)

    scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
    scale.set_value(40)
    col.append(scale)

    rows = Gtk.ListBox()
    rows.add_css_class("boxed-list")
    for name, on in (("Wi-Fi", True), ("Bluetooth", False)):
        row = Gtk.ListBoxRow()
        line = Gtk.Box(spacing=8)
        line.set_margin_top(8)
        line.set_margin_bottom(8)
        line.set_margin_start(12)
        line.set_margin_end(12)
        label = Gtk.Label(label=name, xalign=0)
        label.set_hexpand(True)
        toggle = Gtk.Switch()
        toggle.set_active(on)
        toggle.set_valign(Gtk.Align.CENTER)
        line.append(label)
        line.append(toggle)
        row.set_child(line)
        rows.append(row)
    col.append(rows)

    body.append(col)
    box.append(body)

    win = Gtk.Window()
    win.set_title(TITLE)
    win.set_default_size(WIDTH, HEIGHT)
    win.set_child(box)
    win.present()

    # GTK draws nothing until the compositor maps the window; the parent put
    # it somewhere invisible, so waiting for that is safe.
    ctx = GLib.MainContext.default()
    deadline = GLib.get_monotonic_time() + 5_000_000
    while GLib.get_monotonic_time() < deadline:
        if ctx.pending():
            ctx.iteration(False)
        elif win.get_mapped():
            break

    box.measure(Gtk.Orientation.HORIZONTAL, -1)
    box.allocate(WIDTH, HEIGHT, -1, None)
    snapshot = Gtk.Snapshot()
    Gtk.WidgetPaintable.new(box).snapshot(snapshot, WIDTH, HEIGHT)
    node = snapshot.to_node()
    if node is None:
        sys.exit("henri-gtk-preview: nothing was rendered")

    renderer = Gsk.CairoRenderer()
    renderer.realize(None)
    out.parent.mkdir(parents=True, exist_ok=True)
    renderer.render_texture(node, None).save_to_png(str(out))
    renderer.unrealize()


def gtk3_sheet(out):
    """GTK3 renders offscreen by itself — no compositor involved."""
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk

    win = Gtk.OffscreenWindow()
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    box.set_border_width(14)

    row = Gtk.Box(spacing=8)
    b = Gtk.Button(label="Suggested")
    b.get_style_context().add_class("suggested-action")
    row.pack_start(b, False, False, 0)
    row.pack_start(Gtk.Button(label="Cancel"), False, False, 0)
    switch = Gtk.Switch()
    switch.set_active(True)
    row.pack_start(switch, False, False, 0)
    check = Gtk.CheckButton(label="Check")
    check.set_active(True)
    row.pack_start(check, False, False, 0)
    box.pack_start(row, False, False, 0)

    entry = Gtk.Entry()
    entry.set_placeholder_text("Search")
    box.pack_start(entry, False, False, 0)

    scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
    scale.set_value(40)
    box.pack_start(scale, False, False, 0)

    tabs = Gtk.Notebook()
    for name in ("General", "Advanced"):
        tabs.append_page(Gtk.Label(label="  content  "), Gtk.Label(label=name))
    box.pack_start(tabs, False, False, 0)

    win.add(box)
    win.set_size_request(560, 280)
    win.show_all()
    while Gtk.events_pending():
        Gtk.main_iteration()
    out.parent.mkdir(parents=True, exist_ok=True)
    win.get_pixbuf().savev(str(out), "png", [], [])


# ── the three modes ─────────────────────────────────────────────────────────

def shoot_sheet(out):
    """Render the GTK4 sheet in a child parked on the headless output."""
    monitor, ws = make_output()
    try:
        if out.exists():
            out.unlink()
        launch(f"{sys.executable} {__file__} --sheet-child {out}", ws)
        deadline = time.monotonic() + 25
        while time.monotonic() < deadline:
            if out.exists() and out.stat().st_size:
                print(out)
                return
            time.sleep(0.2)
        sys.exit("henri-gtk-preview: the sheet never wrote its picture")
    finally:
        subprocess.run(["hyprctl", "output", "remove", monitor],
                       stdout=subprocess.DEVNULL)


def shoot_app(command, out, wait=20, settle=2.0):
    """Run a real app on the headless output and capture its toplevel."""
    name = Path(command.split()[0]).name
    monitor, ws = make_output()
    client = None
    try:
        launch(command, ws, size="1100 720")
        client = wait_for_window(ws, name, wait)
        if not client:
            sys.exit(f"henri-gtk-preview: no {name} window on the headless output")
        time.sleep(settle)

        handle = client.get("stableId") or client["address"]
        out.parent.mkdir(parents=True, exist_ok=True)
        grim = subprocess.run(["grim", "-T", str(handle), str(out)],
                              capture_output=True, text=True)
        if grim.returncode:
            sys.exit(f"henri-gtk-preview: grim failed: {grim.stderr.strip()}")
        print(out)
    finally:
        if client:
            try:
                os.kill(client["pid"], 15)
            except (OSError, KeyError, ProcessLookupError):
                pass
        subprocess.run(["hyprctl", "output", "remove", monitor],
                       stdout=subprocess.DEVNULL)


def main():
    argv = sys.argv[1:]

    if argv and argv[0] == "--sheet-child":
        return gtk4_sheet(Path(argv[1]))

    if argv and argv[0] == "--app":
        if len(argv) < 2:
            sys.exit("henri-gtk-preview: --app needs a command")
        return shoot_app(argv[1], Path(argv[2]) if len(argv) > 2 else DEFAULT_OUT)

    if argv and argv[0] == "--gtk3":
        out = Path(argv[1]) if len(argv) > 1 else DEFAULT_OUT
        gtk3_sheet(out)
        print(out)
        return

    shoot_sheet(Path(argv[0]) if argv else DEFAULT_OUT)


if __name__ == "__main__":
    main()
