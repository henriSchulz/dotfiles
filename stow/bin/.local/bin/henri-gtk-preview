#!/usr/bin/env python3
"""Render a sheet of GTK4 widgets to a PNG, without anything showing on screen.

For checking GTK styling (gtk-4.0/gtk.css, the experimental macOS mode, a
theme switch) while the desktop is in use. GTK renders nothing until the
compositor maps the window, so a temporary headless output is created and the
window opens there: mapped, but on no real screen and unfocusable. The picture
is taken in-process with a widget snapshot — Hyprland composites only layers
(bar, wallpaper) on a headless output, never the windows, so grim would come
back with an empty desktop.

  henri-gtk-preview [out.png]      default: ~/Downloads/gtk-preview.png

Only this sheet of stock widgets, not arbitrary apps: the snapshot has to
happen inside the process being styled.
"""
import json
import subprocess
import sys
import time
from pathlib import Path

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gsk", "4.0")
from gi.repository import GLib, Gsk, Gtk  # noqa: E402

TITLE = "henri-gtk-preview"
WIDTH, HEIGHT = 720, 430

out = Path(sys.argv[1] if len(sys.argv) > 1
           else Path.home() / "Downloads/gtk-preview.png")


def hypr(*args, parse=False):
    out = subprocess.run(["hyprctl", *(["-j"] if parse else []), *args],
                         capture_output=True, text=True)
    return json.loads(out.stdout) if parse else out.stdout


def monitors():
    return {m["name"]: m for m in hypr("monitors", "all", parse=True)}


def park():
    """A headless output to map the window on, plus rules that pin it there.

    A hidden special workspace is not enough: Hyprland never maps a window on
    one, and an unmapped widget snapshots to nothing.
    """
    before = set(monitors())
    subprocess.run(["hyprctl", "output", "create", "headless"],
                   stdout=subprocess.DEVNULL)
    for _ in range(60):
        new = set(monitors()) - before
        if new:
            name = new.pop()
            x = max((m["x"] + m["width"] for m in monitors().values()), default=0)
            subprocess.run(["hyprctl", "keyword", "monitor",
                            f"{name},1280x800@60,{x}x0,1"], stdout=subprocess.DEVNULL)
            ws = (monitors()[name].get("activeWorkspace") or {}).get("id")
            rules = [f"keyword windowrulev2 {r},title:^({TITLE})$" for r in
                     (f"workspace {ws} silent", "noinitialfocus", "nofocus", "noanim")]
            subprocess.run(["hyprctl", "--batch", " ; ".join(rules)],
                           stdout=subprocess.DEVNULL)
            time.sleep(0.3)
            return name
        time.sleep(0.1)
    sys.exit("henri-gtk-preview: Hyprland did not create a headless output")


def unpark(monitor):
    subprocess.run(["hyprctl", "output", "remove", monitor], stdout=subprocess.DEVNULL)
    # The window rules were set at runtime; a reload drops them again.
    subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL)


def sheet():
    """One of most things worth looking at: chrome, controls, list, sidebar."""
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

    head = Gtk.HeaderBar()
    head.set_title_widget(Gtk.Label(label="Documents"))
    head.pack_start(Gtk.Button(icon_name="go-previous-symbolic"))
    head.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic"))
    head.pack_end(Gtk.Button(icon_name="edit-find-symbolic"))
    box.append(head)

    body = Gtk.Box()
    side = Gtk.ListBox()
    side.add_css_class("navigation-sidebar")
    for name in ("Home", "Recent", "Starred", "Trash"):
        row = Gtk.ListBoxRow()
        row.set_child(Gtk.Label(label=name, xalign=0))
        side.append(row)
    side.select_row(side.get_row_at_index(0))
    body.append(side)

    col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    col.set_hexpand(True)
    for edge in ("top", "bottom", "start", "end"):
        getattr(col, f"set_margin_{edge}")(16)

    buttons = Gtk.Box(spacing=8)
    for label, css in (("Suggested", "suggested-action"), ("Cancel", None),
                       ("Destructive", "destructive-action")):
        b = Gtk.Button(label=label)
        if css:
            b.add_css_class(css)
        buttons.append(b)
    col.append(buttons)

    controls = Gtk.Box(spacing=12)
    switch = Gtk.Switch()
    switch.set_active(True)
    switch.set_valign(Gtk.Align.CENTER)
    controls.append(switch)
    check = Gtk.CheckButton(label="Checkbox")
    check.set_active(True)
    controls.append(check)
    radio = Gtk.CheckButton(label="Radio")
    radio.set_group(Gtk.CheckButton())
    radio.set_active(True)
    controls.append(radio)
    col.append(controls)

    entry = Gtk.Entry()
    entry.set_placeholder_text("Search documents")
    col.append(entry)

    scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
    scale.set_value(40)
    col.append(scale)

    progress = Gtk.ProgressBar()
    progress.set_fraction(0.6)
    col.append(progress)

    rows = Gtk.ListBox()
    rows.add_css_class("boxed-list")
    for name, on in (("Wi-Fi", True), ("Bluetooth", False)):
        row = Gtk.ListBoxRow()
        line = Gtk.Box(spacing=8)
        line.set_margin_top(8)
        line.set_margin_bottom(8)
        line.set_margin_start(12)
        line.set_margin_end(12)
        label = Gtk.Label(label=name, xalign=0)
        label.set_hexpand(True)
        toggle = Gtk.Switch()
        toggle.set_active(on)
        toggle.set_valign(Gtk.Align.CENTER)
        line.append(label)
        line.append(toggle)
        row.set_child(line)
        rows.append(row)
    col.append(rows)

    body.append(col)
    box.append(body)
    return box


def main():
    monitor = park()
    try:
        render()
    finally:
        unpark(monitor)


def render():
    win = Gtk.Window()
    win.set_title(TITLE)
    win.set_default_size(WIDTH, HEIGHT)
    win.set_child(sheet())
    win.present()

    # Let mapping, styling and layout settle before the snapshot.
    ctx = GLib.MainContext.default()
    deadline = GLib.get_monotonic_time() + 2_000_000
    while GLib.get_monotonic_time() < deadline:
        if ctx.pending():
            ctx.iteration(False)
        elif win.get_mapped():
            break

    child = win.get_child()
    child.measure(Gtk.Orientation.HORIZONTAL, -1)
    child.allocate(WIDTH, HEIGHT, -1, None)
    snapshot = Gtk.Snapshot()
    Gtk.WidgetPaintable.new(child).snapshot(snapshot, WIDTH, HEIGHT)
    node = snapshot.to_node()
    if node is None:
        sys.exit("henri-gtk-preview: nothing was rendered")

    renderer = Gsk.CairoRenderer()
    renderer.realize(None)
    out.parent.mkdir(parents=True, exist_ok=True)
    renderer.render_texture(node, None).save_to_png(str(out))
    renderer.unrealize()
    win.destroy()
    print(out)


if __name__ == "__main__":
    main()
