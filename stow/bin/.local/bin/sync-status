#!/usr/bin/env python3
"""What the sync between the M1 and the tablet is doing, for the menu bar
(henri.cast-v3 shows it in its popup). Writes $XDG_RUNTIME_DIR/henri/sync.json:

  peer       the tablet connected to Syncthing (over the cable)
  files      Syncthing folders: count, errors, how far the tablet is (percent)
  conflicts  number of *.sync-conflict-* files, and the newest few paths
  dotfiles   problems dotfiles-peer-sync reported last time ([] = fine)
  settings   settings-sync files that differ from the shared copy
  time       when this was written

Run by sync-status.timer every 30 s (M1 only, hosts/m1).
"""
import json, os, subprocess, time, urllib.request

HOME = os.path.expanduser("~")
RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "henri")
CFG = os.path.join(HOME, ".local/state/syncthing/config.xml")
PEER = "tablet"


def api(key, path):
    req = urllib.request.Request("http://127.0.0.1:8384" + path, headers={"X-API-Key": key})
    with urllib.request.urlopen(req, timeout=5) as r:
        return json.loads(r.read())


def syncthing():
    out = {"peer": False, "files": {"folders": 0, "errors": 0, "syncing": 0, "peerPercent": None}}
    try:
        key = open(CFG).read().split("<apikey>")[1].split("</apikey>")[0]
        peer = next(d["deviceID"] for d in api(key, "/rest/config/devices") if d["name"] == PEER)
        conns = api(key, "/rest/system/connections")["connections"]
        out["peer"] = bool(conns.get(peer, {}).get("connected"))
        folders = [f["id"] for f in api(key, "/rest/config/folders")]
        f = out["files"]
        f["folders"] = len(folders)
        for fid in folders:
            s = api(key, f"/rest/db/status?folder={fid}")
            f["errors"] += s.get("errors", 0) + s.get("pullErrors", 0) + (1 if s.get("error") else 0)
            if s.get("state") not in ("idle", ""):
                f["syncing"] += 1
        f["peerPercent"] = round(api(key, f"/rest/db/completion?device={peer}")["completion"], 1)
    except Exception:
        pass
    return out


def conflicts():
    prune = ["node_modules", "target", ".venv", ".stversions"]
    roots = [os.path.join(HOME, d) for d in ("Documents", "Uni", "Work", "Pictures", "Projects", ".local/state/henri/settings-shared")]
    cmd = ["find", *[r for r in roots if os.path.isdir(r)], "("]
    for i, p in enumerate(prune):
        cmd += (["-o"] if i else []) + ["-name", p]
    cmd += [")", "-prune", "-o", "-name", "*.sync-conflict-*", "-print"]
    paths = subprocess.run(cmd, capture_output=True, text=True).stdout.split("\n")
    paths = sorted((p for p in paths if p), key=lambda p: os.path.getmtime(p) if os.path.exists(p) else 0, reverse=True)
    return {"count": len(paths), "newest": paths[:5]}


def dotfiles():
    p = os.path.join(HOME, ".local/state/henri/dotfiles-peer-sync.last")
    try:
        return [l for l in open(p).read().split("\n") if l]
    except FileNotFoundError:
        return []


def settings():
    try:
        r = subprocess.run([os.path.join(HOME, ".local/bin/settings-sync"), "--status"], capture_output=True, text=True, timeout=10)
        return [l.split()[0] for l in r.stdout.split("\n") if "DIFFERS" in l]
    except Exception:
        return []


def main():
    data = syncthing()
    data.update({"conflicts": conflicts(), "dotfiles": dotfiles(), "settings": settings(), "time": time.time()})
    os.makedirs(RUN, exist_ok=True)
    tmp = os.path.join(RUN, "sync.json.tmp")
    with open(tmp, "w") as h:
        json.dump(data, h)
    os.replace(tmp, os.path.join(RUN, "sync.json"))


if __name__ == "__main__":
    main()
