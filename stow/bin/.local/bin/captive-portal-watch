#!/bin/bash
# Open the login page of captive portals (WIFIonICE, hotels, cafés) the way
# macOS does: NetworkManager already detects them (connectivity 'portal'),
# Omarchy just never shows anything. Runs from autostart.lua.
#
# Opens a plain-http URL on purpose: HTTPS pages can't be redirected by the
# portal, so a browser on the last tab just times out.

probe_url='http://ping.archlinux.org/nm-check.txt'
opened=""

# NM only re-checks every few minutes; poll after opening so the status bar
# flips to online right after the login instead of minutes later.
wait_for_login() {
  for _ in $(seq 60); do
    sleep 5
    [[ $(nmcli networking connectivity check 2>/dev/null) == full ]] && return
  done
}

handle() {
  case $1 in
    portal)
      [[ -n $opened ]] && return
      opened=1
      notify-send -a "Wi-Fi" "Sign-in required" "$(nmcli -t -f NAME con show --active 2>/dev/null | grep -v '^lo$' | head -1)"
      omarchy launch browser "$probe_url" >/dev/null 2>&1 &
      wait_for_login &
      ;;
    full|none) opened="" ;;
  esac
}

handle "$(nmcli networking connectivity check 2>/dev/null)"

while read -r line; do
  [[ $line =~ ^Connectivity\ is\ now\ \'([a-z]+)\' ]] && handle "${BASH_REMATCH[1]}"
done < <(nmcli monitor 2>/dev/null)
