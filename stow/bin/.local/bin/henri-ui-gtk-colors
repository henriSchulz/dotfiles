#!/usr/bin/env python3
"""Write the active Omarchy theme as GTK CSS variables (--hui-*).

~/.config/gtk-4.0/gtk.css imports the result, so stock GTK apps restyled with
henri-ui (Files) follow the theme. Run by the theme-set hook; running GTK apps
pick the new colors up on their next start.

GTK3 has no CSS variables, so GTK3 stylesheets are templates instead:
~/.local/share/henri-ui/gtk3/<name>.css.in is rendered with the same colors
plus the gtk-tokens.css values into ~/.local/share/themes/<Theme>/gtk-3.0/
gtk.css and friends (GTK3_TEMPLATES below). Quick Look (Sushi) runs with such a theme.
"""
import os
import re
import tomllib
from pathlib import Path

home = Path.home()
theme = home / ".local/state/omarchy/current/theme"
out = Path(os.environ.get("XDG_STATE_HOME", home / ".local/state")) / "henri-ui/gtk-colors.css"


def load(name):
    try:
        with open(theme / name, "rb") as f:
            return tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        return {}


def luminance(hex_color):
    def channel(v):
        v /= 255
        return v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4
    h = hex_color.lstrip("#")
    r, g, b = (int(h[i:i + 2], 16) for i in (0, 2, 4))
    return 0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b)


def on_color(hex_color):
    """White or black text on a colored fill, whichever contrasts more (Motion.onColor)."""
    lum = luminance(hex_color)
    return "#ffffff" if 1.05 / (lum + 0.05) >= (lum + 0.05) / 0.05 else "#000000"


c = load("colors.toml")
menu = load("shell.menu.toml").get("menu", {})
font = load("shell.font.toml").get("font", {})

bg = c.get("background", "#f5f5f7")
fg = c.get("foreground", "#1d1d1f")
accent = c.get("accent", "#0071e3")
selected_bg = menu.get("selected-background", accent)
tokens = {
    "hui-bg": bg,
    # Content view: white in light mode (macOS/Finder), the plain background in dark.
    "hui-view": "#ffffff" if c.get("mode", "light") == "light" else bg,
    "hui-bg-dark": c.get("dark_background", bg),
    "hui-bg-darker": c.get("darker_background", bg),
    "hui-fg": fg,
    "hui-accent": accent,
    "hui-on-accent": on_color(accent),
    "hui-selection": c.get("selection", accent),
    "hui-urgent": c.get("red", "#d70015"),
    "hui-menu-selected-bg": selected_bg,
    "hui-menu-selected-fg": menu.get("selected-text", on_color(selected_bg)),
    "hui-surface-alpha": f"{round(float(menu.get('background-alpha', 0.97)) * 100)}%",
    "hui-font-size": f"{font.get('base-size', 13)}px",
}

out.parent.mkdir(parents=True, exist_ok=True)
body = "\n".join(f"  --{k}: {v};" for k, v in tokens.items())
tmp = out.with_suffix(".tmp")
tmp.write_text(
    "/* Generated by henri-ui-gtk-colors from the active Omarchy theme"
    f" ({c.get('mode', 'light')}). Do not edit. */\n:root {{\n{body}\n}}\n"
)
tmp.replace(out)


# ── GTK3 themes from templates ──────────────────────────────────────────────
# template (in henri-ui/gtk3/) -> rendered file
GTK3_TEMPLATES = {
    "quicklook.css.in": home / ".local/share/themes/HenriQuickLook/gtk-3.0/gtk.css",
    "quicklook-scheme.xml.in": home / ".local/share/gtksourceview-4/styles/henri-quicklook.xml",
}
henri_ui = home / ".local/share/henri-ui"


def css_tokens(path):
    try:
        text = path.read_text()
    except OSError:
        return {}
    return dict(re.findall(r"--([a-z0-9-]+):\s*([^;]+);", text))


def fraction(value, default):
    """'12%' -> '0.12' for GTK3's alpha()."""
    m = re.match(r"\s*([0-9.]+)%", str(value))
    return f"{float(m.group(1)) / 100:g}" if m else default


values = dict(tokens)
values.update(css_tokens(henri_ui / "gtk-tokens.css"))
values["adwaita"] = "gtk-contained.css" if c.get("mode", "light") == "light" else "gtk-contained-dark.css"
values["hairline"] = fraction(values.get("hairline-alpha"), "0.12")
values["secondary"] = fraction(values.get("secondary-text-alpha"), "0.65")
values["surface"] = fraction(tokens["hui-surface-alpha"], "0.97")
# Plain theme colors too (muted, red, dark-foreground, ...), for syntax schemes.
values.update({k.replace("_", "-"): v for k, v in c.items()
               if isinstance(v, str) and v.startswith("#")})

for name, target in GTK3_TEMPLATES.items():
    template = henri_ui / "gtk3" / name
    if not template.exists():
        continue
    missing = set()

    def fill(m):
        key = m.group(1)
        if key not in values:
            missing.add(key)
            return m.group(0)
        return values[key]

    css = re.sub(r"\{\{([a-z0-9-]+)\}\}", fill, template.read_text())
    if missing:
        print(f"henri-ui-gtk-colors: {template.name}: unknown tokens {sorted(missing)}")
    target.parent.mkdir(parents=True, exist_ok=True)
    tmp = target.with_suffix(".tmp")
    tmp.write_text(css)
    tmp.replace(target)
