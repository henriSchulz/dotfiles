#!/usr/bin/env python3
"""headless-sounds — sound sets for headless-events.

  headless-sounds list              sets and the active one
  headless-sounds preview [set]     play every event of a set (all sets if omitted)
  headless-sounds use <set>         switch headless-events to a set ("default" = freedesktop)
  headless-sounds gen               (re)write the synthesised sets
  headless-sounds fetch             download the macOS sound library (kept out of git)
  headless-sounds library [filter]  play every library sound, printing its name
  headless-sounds assign <event> <sound>   pick a library sound for one event
  headless-sounds show              what each event plays right now

Events: complete, network-connectivity-lost, network-connectivity-established,
device-added, device-removed, message, login-screen (greeter shown), login-failed,
login-ok (played by the root daemon headless-statusd). `assign` fills the set "custom" and
switches to it. Library: ~/.local/share/headless/library/.

Sets are synthesised into ~/.local/share/headless/sounds/<set>/<event>.wav;
the active one is named in ~/.config/headless/soundset. headless-events reads it
on every sound, so `use` takes effect at once. Volume is headless-events' VOL
(a fraction of the master volume), not baked into the files.
"""
import math, os, struct, subprocess, sys, time, wave

HOME = os.path.expanduser("~")
ROOT = f"{HOME}/.local/share/headless/sounds"
CONF = f"{HOME}/.config/headless/soundset"
RATE = 44100

# Note names -> Hz (equal temperament, A4 = 440).
def hz(name):
    names = {"C": 0, "D": 2, "E": 4, "F": 5, "G": 7, "A": 9, "B": 11}
    n = names[name[0]] + 12 * (int(name[-1]) - 4) - 9
    return 440.0 * 2 ** (n / 12)

# event -> notes. Net events sit in the middle, charger events higher.
EVENTS = {
    "complete":                         ["C5", "E5", "G5"],
    "network-connectivity-lost":        ["E5", "A4"],
    "network-connectivity-established": ["A4", "E5"],
    "device-added":                     ["G5", "C6"],
    "device-removed":                   ["C6", "G5"],
    "message":                          ["A4"],
    "login-screen":                     ["D5", "A5"],
    "login-failed":                     ["A4", "F4"],
    "login-ok":                         ["E5", "A5", "C6"],
}

# set -> timbre. partials: (ratio, gain); decay: 1/s; gap: s between notes;
# length: s per note; attack: s; octave: shift.
SETS = {
    "bell":    dict(partials=[(1, 1), (2.76, .35), (5.4, .15)], decay=5.0, gap=.17, length=.7, attack=.003, octave=0),
    "marimba": dict(partials=[(1, 1), (4, .3)],                 decay=9.0, gap=.14, length=.45, attack=.002, octave=-1),
    "soft":    dict(partials=[(1, 1), (2, .2)],                 decay=3.0, gap=.22, length=.8, attack=.05,  octave=0),
    "glass":   dict(partials=[(1, 1), (3, .4), (5, .2)],        decay=4.0, gap=.12, length=.9, attack=.004, octave=1),
}

def render(notes, p):
    total = p["gap"] * (len(notes) - 1) + p["length"] + .05
    buf = [0.0] * int(total * RATE)
    for i, name in enumerate(notes):
        f0 = hz(name) * 2 ** p["octave"]
        start = int(i * p["gap"] * RATE)
        for k in range(int(p["length"] * RATE)):
            t = k / RATE
            env = min(1.0, t / p["attack"]) * math.exp(-t * p["decay"])
            tail = min(1.0, (p["length"] - t) / .05)      # no click at the end
            s = sum(g * math.sin(2 * math.pi * f0 * r * t) for r, g in p["partials"])
            if start + k < len(buf):
                buf[start + k] += s * env * tail
    peak = max(abs(x) for x in buf) or 1
    return [x / peak * .9 for x in buf]

def gen():
    for name, p in SETS.items():
        os.makedirs(f"{ROOT}/{name}", exist_ok=True)
        for ev, notes in EVENTS.items():
            data = render(notes, p)
            with wave.open(f"{ROOT}/{name}/{ev}.wav", "wb") as w:
                w.setnchannels(1); w.setsampwidth(2); w.setframerate(RATE)
                w.writeframes(b"".join(struct.pack("<h", int(x * 32767)) for x in data))

LIB = f"{HOME}/.local/share/headless/library"
SOURCES = [  # (repo, tree path prefix, file prefix)
    ("zquestz/macos-sound-theme", "macos/error/", "mac-"),
    ("zquestz/macos-sound-theme", "macos/stereo/", "theme-"),
    ("lucagoc/MacOSSounds4Gnome", "stereo/", "gnome-"),
]

def fetch():
    import hashlib, json, urllib.request
    os.makedirs(LIB, exist_ok=True)
    seen = {hashlib.md5(open(f"{LIB}/{f}", "rb").read()).hexdigest() for f in os.listdir(LIB)}
    for repo, prefix, pre in SOURCES:
        tree = json.load(urllib.request.urlopen(f"https://api.github.com/repos/{repo}/git/trees/HEAD?recursive=1"))
        for t in tree["tree"]:
            if t["type"] == "blob" and t["path"].startswith(prefix) and t["path"].endswith(".ogg"):
                dst = f"{LIB}/{pre}{os.path.basename(t['path'])}"
                if os.path.exists(dst): continue
                data = urllib.request.urlopen(f"https://raw.githubusercontent.com/{repo}/HEAD/{t['path']}").read()
                h = hashlib.md5(data).hexdigest()
                if h in seen: continue   # same sound under another name
                seen.add(h); open(dst, "wb").write(data)
    print(len(os.listdir(LIB)), "sounds in", LIB)

def lib_path(name):
    for cand in (name, f"{name}.ogg", f"mac-{name}.ogg"):
        if os.path.exists(f"{LIB}/{cand}"): return f"{LIB}/{cand}"
    sys.exit(f"not in library: {name}  (headless-sounds library)")

def play(path, vol):
    subprocess.run(["pw-play", f"--volume={vol}", path])

def active():
    try:
        return open(CONF).read().strip() or "default"
    except OSError:
        return "default"

def main():
    a = sys.argv[1:]
    cmd = a[0] if a else "list"
    if cmd == "gen" or not os.path.isdir(ROOT):
        gen()
    vol = os.environ.get("HEADLESS_VOL", "0.5")
    if cmd == "list":
        print(f"active: {active()}")
        for s in ["default"] + list(SETS): print(" ", s)
    elif cmd == "preview":
        for s in (a[1:2] or list(SETS)):
            print(f"== {s}")
            for ev in EVENTS:
                print(f"   {ev}")
                play(f"{ROOT}/{s}/{ev}.wav", vol); time.sleep(.8)
    elif cmd == "fetch":
        fetch()
    elif cmd == "library":
        if not os.path.isdir(LIB): fetch()
        for f in sorted(os.listdir(LIB)):
            if len(a) > 1 and a[1].lower() not in f.lower(): continue
            print(f"   {f[:-4]}")
            play(f"{LIB}/{f}", vol); time.sleep(.6)
    elif cmd == "assign" and len(a) > 2:
        if a[1] not in EVENTS: sys.exit(f"unknown event: {a[1]}")
        src = lib_path(a[2])
        d = f"{ROOT}/custom"; os.makedirs(d, exist_ok=True)
        # events not assigned yet keep playing the current set's sound
        for ev in EVENTS:
            dst = f"{d}/{ev}.wav"
            if not os.path.lexists(f"{d}/{ev}.wav") and not any(os.path.lexists(f"{d}/{ev}{e}") for e in (".ogg",)):
                cur = active()
                base = f"{ROOT}/{cur}/{ev}.wav"
                if cur in SETS and os.path.exists(base): os.symlink(base, dst)
        for e in (".wav", ".ogg"):
            if os.path.lexists(f"{d}/{a[1]}{e}"): os.remove(f"{d}/{a[1]}{e}")
        os.symlink(src, f"{d}/{a[1]}.ogg")
        os.makedirs(os.path.dirname(CONF), exist_ok=True); open(CONF, "w").write("custom")
        print(f"{a[1]} -> {os.path.basename(src)[:-4]}  (set: custom)")
        play(src, vol)
    elif cmd == "show":
        cur = active(); print(f"set: {cur}")
        for ev in EVENTS:
            for e in (".wav", ".ogg"):
                f = f"{ROOT}/{cur}/{ev}{e}"
                if os.path.lexists(f): print(f"  {ev:36} {os.path.basename(os.path.realpath(f))}"); break
            else: print(f"  {ev:36} freedesktop")
    elif cmd == "use" and len(a) > 1:
        if a[1] != "default" and a[1] not in SETS and not os.path.isdir(f"{ROOT}/{a[1]}"):
            sys.exit(f"unknown set: {a[1]}")
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        open(CONF, "w").write("" if a[1] == "default" else a[1])
        print(f"now: {a[1]}")
    elif cmd not in ("gen", "fetch"):
        sys.exit(__doc__)

main()
