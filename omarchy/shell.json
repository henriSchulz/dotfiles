{
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "",
    "layout": {
      "left": [
        {
          "id": "henri.system-menu"
        },
        {
          "id": "henri.active-window"
        }
      ],
      "center": [
        {
          "id": "henri.workspaces"
        }
      ],
      "right": [
        {
          "id": "henri.power",
          "chargeLimitStep": 5,
          "showPercentage": true,
          "historyHours": "6"
        },
        {
          "id": "henri.control-center"
        },
        {
          "id": "henri.clock",
          "format": "ddd d. MMM HH:mm",
          "formatAlt": "d. MMMM 'KW'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ]
    },
    "id": "henri.bar"
  },
  "cloneSourceRestores": [
    "henri.menu",
    "io.github.sirjul1337.lock-explorer",
    "henri.idle",
    "henri.background"
  ],
  "disabledPlugins": [
    "omarchy.menu",
    "omarchy.lock",
    "omarchy.idle",
    "omarchy.background"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "henri.missioncontrol"
    },
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "design": "poster"
    },
    {
      "id": "henri.idle"
    },
    {
      "id": "henri.menu"
    },
    {
      "id": "henri.workspace-switcher"
    },
    {
      "id": "henri.background"
    },
    {
      "id": "henri.wallpaper"
    }
  ],
  "version": 1
}
