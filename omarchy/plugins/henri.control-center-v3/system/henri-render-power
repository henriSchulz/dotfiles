#!/bin/bash
# henri-render-power on|off|toggle|status
# henri-render-power effects on|off|toggle
#
# Two Hyprland rendering experiments, switched from Control Center → Experiments.
# Each flag file is the whole state; ~/.config/hypr/looknfeel.lua reads them on
# every (re)load:
#   low-power-render  direct scanout, 2 blur passes, color management off
#   no-effects        blur, shadows and animations off (M1 power measurements,
#                     ~/Projects/m1-power). Without blur the glass surfaces only
#                     look washed out, so this also turns on Velum's Reduce
#                     Transparency (opaque material) in
#                     ~/.local/state/velum/settings.json — every Velum surface
#                     follows the file live, no shell restart. Turning the
#                     effects back on clears it again only if this script set
#                     it (marker no-effects-opaque), so a Reduce Transparency
#                     the user chose stays.
# `status` prints key=value lines the panel parses, including the values
# Hyprland actually runs with, so the switches never lie about what is applied.
set -euo pipefail
dir="${XDG_STATE_HOME:-$HOME/.local/state}/henri"
flag="$dir/low-power-render"

if [[ ${1:-} == effects ]]; then
  flag="$dir/no-effects"
  shift
  [[ ${1:-} == status ]] && exec "$0" status
fi

# Mirror the no-effects flag into Velum's reduceTransparency.
solid_menus() {
  local velum="${XDG_STATE_HOME:-$HOME/.local/state}/velum/settings.json" mark="$dir/no-effects-opaque" want
  [[ -f $velum ]] || return 0
  want=$(jq -r '.reduceTransparency == true' "$velum" 2>/dev/null) || return 0
  if [[ -e $dir/no-effects ]]; then
    [[ $want == true ]] && return 0          # already opaque (the user's choice): leave it, no marker
    : > "$mark"; want=true
  else
    [[ -e $mark ]] || return 0               # not ours to clear
    rm -f "$mark"; [[ $want == true ]] || return 0
    want=false
  fi
  # written in place (not replaced): the shells' file watch stays on the same file
  local new; new=$(jq --argjson v "$want" '.reduceTransparency = $v' "$velum")
  printf '%s\n' "$new" > "$velum"
}

case "${1:-status}" in
  on)     mkdir -p "$dir"; : > "$flag"; hyprctl reload >/dev/null; if [[ $flag == */no-effects ]]; then solid_menus; fi ;;
  off)    rm -f "$flag"; hyprctl reload >/dev/null; if [[ $flag == */no-effects ]]; then solid_menus; fi ;;
  toggle) if [[ -e $flag ]]; then set -- off; else set -- on; fi
          [[ $flag == */no-effects ]] && exec "$0" effects "$1"; exec "$0" "$1" ;;
  status) ;;
  *)      echo "usage: ${0##*/} [effects] on|off|toggle|status" >&2; exit 2 ;;
esac

opt() { hyprctl getoption "$1" 2>/dev/null | awk '/^\s*(int|bool|float):/ {print $2; exit}'; }
if [[ -e $dir/low-power-render ]]; then echo "state=on"; else echo "state=off"; fi
if [[ -e $dir/no-effects ]]; then echo "effects=off"; else echo "effects=on"; fi
echo "scanout=$(opt render:direct_scanout)"
echo "passes=$(opt decoration:blur:passes)"
echo "cm=$(opt render:cm_enabled)"
echo "blur=$(opt decoration:blur:enabled)"
echo "shadow=$(opt decoration:shadow:enabled)"
echo "anim=$(opt animations:enabled)"
