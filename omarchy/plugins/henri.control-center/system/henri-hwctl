#!/bin/bash
# Hardware control helper for the henri.control-center "Hardware" page.
#
# Installed root-owned to /usr/local/bin with a NOPASSWD sudoers rule (see
# install.sh), so every argument is validated strictly here. `status` needs no
# privileges; everything else writes sysfs and must run as root.
#
#   henri-hwctl status              JSON snapshot for the panel
#   henri-hwctl thermal MODE        Dell firmware thermal mode (cool, quiet, …)
#   henri-hwctl turbo on|off        Intel Turbo Boost
#   henri-hwctl max-perf 20..100    intel_pstate max_perf_pct
#
# Direct fan control is not offered: on the XPS 13 9310 the EC ignores the
# SMM fan commands (pwm writes read back 0, pwm1_enable=2 fails with EINVAL).
# The firmware thermal modes are what actually shape the fan curve.
set -u
export PATH=/usr/bin

PSTATE=/sys/devices/system/cpu/intel_pstate
PROFILE=/sys/firmware/acpi/platform_profile

hwmon_by_name() {
  local d
  for d in /sys/class/hwmon/hwmon*; do
    [[ $(cat "$d/name" 2>/dev/null) == "$1" ]] && { printf '%s' "$d"; return 0; }
  done
  return 1
}

DELL=$(hwmon_by_name dell_smm || true)
DDV=$(hwmon_by_name dell_ddv || true)
CORE=$(hwmon_by_name coretemp || true)

die() { printf 'henri-hwctl: %s\n' "$*" >&2; exit 1; }
need_root() { (( EUID == 0 )) || die "must run as root"; }
read_int() { local v; v=$(cat "$1" 2>/dev/null) && [[ $v =~ ^-?[0-9]+$ ]] && printf '%s' "$v" || printf -- '-1'; }

cpu_temp() {
  local t
  [[ -n $CORE ]] || { printf -- '-1'; return; }
  t=$(read_int "$CORE/temp1_input")
  (( t >= 0 )) && printf '%d' $(( t / 1000 )) || printf -- '-1'
}

json_list() { local out="" w; for w in $1; do out+="${out:+,}\"$w\""; done; printf '[%s]' "$out"; }

cmd_status() {
  local fans="" i label rpm max
  if [[ -n $DELL ]]; then
    for i in 1 2 3; do
      [[ -r $DELL/fan${i}_input ]] || continue
      # dell_smm refuses fan*_label on some models; dell_ddv names the same fans.
      label=$(cat "$DELL/fan${i}_label" "$DDV/fan${i}_label" 2>/dev/null | head -n1)
      [[ -n $label ]] || label="Fan $i"
      rpm=$(read_int "$DELL/fan${i}_input")
      max=$(read_int "$DELL/fan${i}_max")
      fans+="${fans:+,}{\"label\":\"${label//\"/}\",\"rpm\":$rpm,\"max\":$max}"
    done
  fi
  printf '{"fans":[%s],"thermal":"%s","thermalChoices":%s,' \
    "$fans" "$(cat $PROFILE 2>/dev/null)" "$(json_list "$(cat ${PROFILE}_choices 2>/dev/null)")"
  # helper: the root-owned install exists and matches this copy.
  printf '"cpuTemp":%d,"turbo":%s,"maxPerf":%d,"helper":%s}\n' \
    "$(cpu_temp)" \
    "$([[ $(read_int $PSTATE/no_turbo) == 0 ]] && echo true || echo false)" \
    "$(read_int $PSTATE/max_perf_pct)" \
    "$(cmp -s "$0" /usr/local/bin/henri-hwctl && echo true || echo false)"
}

cmd_thermal() {
  need_root
  local choices
  choices=$(cat "${PROFILE}_choices" 2>/dev/null) || die "no firmware thermal modes"
  [[ ${1:-} =~ ^[a-z-]+$ && " $choices " == *" $1 "* ]] || die "thermal: expected one of: $choices"
  printf '%s' "$1" > "$PROFILE" || die "could not set thermal mode"
  cmd_status
}

cmd_turbo() {
  need_root
  case "${1:-}" in
    on) printf 0 > "$PSTATE/no_turbo" ;;
    off) printf 1 > "$PSTATE/no_turbo" ;;
    *) die "turbo: expected on|off" ;;
  esac || die "turbo cannot be changed on this system"
  cmd_status
}

cmd_max_perf() {
  need_root
  [[ ${1:-} =~ ^[0-9]{2,3}$ ]] && (( 10#$1 >= 20 && 10#$1 <= 100 )) || die "max-perf: expected 20..100"
  printf '%d' "$((10#$1))" > "$PSTATE/max_perf_pct" || die "could not set max_perf_pct"
  cmd_status
}

case "${1:-}" in
  status) cmd_status ;;
  thermal) cmd_thermal "${2:-}" ;;
  turbo) cmd_turbo "${2:-}" ;;
  max-perf) cmd_max_perf "${2:-}" ;;
  *) die "usage: henri-hwctl status|thermal MODE|turbo on|off|max-perf N" ;;
esac
